                </td>
            </tr>

            <tr>
                <td>10:00 AM</td>
                <td><strong>Amit Kumar</strong></td>
                <td>Follow-up</td>
                <td>A-047</td>
                <td>
                    <select class="badge-status waiting" onchange="this.className = 'badge-status ' + this.value" style="border:none; cursor:pointer;" aria-label="Status">
                        <option value="in-progress">In Progress</option>
                        <option value="waiting" selected>Waiting</option>
                    </select>
                </td>
