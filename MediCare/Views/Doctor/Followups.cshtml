@{
    ViewData["Title"] = "Followups";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    body {
        background: #f4f6f9;
    }

    /* ===== Topbar ===== */
    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .search-wrapper {
        position: relative;
        width: 400px;
    }

        .search-wrapper input {
            width: 100%;
            height: 45px;
            border-radius: 14px;
            border: 1px solid #e5e7eb;
            padding-left: 40px;
            background: #f9fafb;
        }

        .search-wrapper i {
            position: absolute;
            top: 14px;
            left: 14px;
            color: #9ca3af;
        }

    .profile-area {
        display: flex;
        align-items: center;
        gap: 20px;
    }

        .profile-area i {
            font-size: 18px;
            color: #6b7280;
            cursor: pointer;
        }

    .profile-circle {
        width: 40px;
        height: 40px;
        background: #10b981;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }

    /* ===== Page Title ===== */
    .page-title {
        font-size: 26px;
        font-weight: 700;
    }

    .page-subtitle {
        color: #6b7280;
        margin-bottom: 25px;
    }

    /* ===== Main Card ===== */
    .main-card {
        background: #ffffff;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .table thead th {
        font-size: 12px;
        text-transform: uppercase;
        color: #9ca3af;
        font-weight: 600;
        border: none;
    }

    .table tbody tr {
        background: #f9fafb;
    }

    .table tbody td {
        vertical-align: middle;
        border-top: none;
    }

    .status-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .scheduled {
        background: #d1fae5;
        color: #059669;
    }

    .pending {
        background: #fef3c7;
        color: #d97706;
    }

    .action-btn {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-left: 6px;
        cursor: pointer;
    }

    .pagination-box {
        margin-top: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
        color: #6b7280;
    }

        .pagination-box button {
            border-radius: 10px;
            padding: 6px 15px;
            border: 1px solid #e5e7eb;
            background: #ffffff;
            margin-left: 8px;
        }
</style>

<!-- ===== Top Bar ===== -->
<div class="topbar">

    <div class="search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" placeholder="Search patients, appointments..." />
    </div>

    <div class="profile-area">
        <i class="fa fa-bell"></i>
        <div class="profile-circle">
            DR
        </div>
    </div>

</div>

<!-- ===== Page Title ===== -->
<div class="page-title">Follow-up Patients</div>
<div class="page-subtitle">Manage follow-up appointments</div>

<!-- ===== Main Content ===== -->
<div class="main-card">

    <div class="search-wrapper mb-4">
        <i class="fa fa-search"></i>
        <input type="text" placeholder="Search follow-ups..." />
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Patient</th>
                <th>Last Visit</th>
                <th>Next Visit</th>
                <th>Diagnosis</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>

            <tr>
                <td><strong>John Smith</strong></td>
                <td>2024-02-10</td>
                <td>2024-02-24</td>
                <td>Hypertension</td>
                <td>
                    <span class="status-badge scheduled">Scheduled</span>
                </td>
                <td class="text-end">
                    <span class="action-btn">
                        <i class="fa fa-eye text-muted"></i>
                    </span>
                    <span class="action-btn">
                        <i class="fa fa-phone text-muted"></i>
                    </span>
                </td>
            </tr>

            <tr>
                <td><strong>Sarah Johnson</strong></td>
                <td>2024-02-11</td>
                <td>2024-02-25</td>
                <td>Diabetes Check</td>
                <td>
                    <span class="status-badge pending">Pending</span>
                </td>
                <td class="text-end">
                    <span class="action-btn">
                        <i class="fa fa-eye text-muted"></i>
                    </span>
                    <span class="action-btn">
                        <i class="fa fa-phone text-muted"></i>
                    </span>
                </td>
            </tr>

            <tr>
                <td><strong>Michael Chen</strong></td>
                <td>2024-02-08</td>
                <td>2024-02-22</td>
                <td>Post Surgery</td>
                <td>
                    <span class="status-badge scheduled">Scheduled</span>
                </td>
                <td class="text-end">
                    <span class="action-btn">
                        <i class="fa fa-eye text-muted"></i>
                    </span>
                    <span class="action-btn">
                        <i class="fa fa-phone text-muted"></i>
                    </span>
                </td>
            </tr>

        </tbody>
    </table>

    <!-- Pagination -->
    <div class="pagination-box">
        <div>Showing 3 results</div>
        <div>
            <button>Previous</button>
            <button>Next</button>
        </div>
    </div>

</div>