@{
    ViewData["Title"] = "Examination";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 30px;
    }
    .page-header h3 {
        font-weight: 700;
        margin-bottom: 4px;
        color: #1a1a1a;
        font-size: 24px;
    }
    .page-header p {
        color: #6b7280;
        font-size: 14px;
    }

    .placeholder-card {
        background: white;
        border-radius: 16px;
        padding: 40px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }
    .placeholder-card i {
        font-size: 48px;
        color: #cbd5e1;
        margin-bottom: 16px;
    }
    .placeholder-card h5 {
        color: #1a1a1a;
        font-weight: 600;
        margin-bottom: 8px;
    }
    .placeholder-card p {
        color: #6b7280;
    }
</style>

<div class="page-header">
    <h3>Patient Examination</h3>
    <p>Perform examinations</p>
</div>

<div class="placeholder-card">
    <i class="fa-regular fa-clock"></i>
    <h5>Examination Module</h5>
    <p>This module is under development.</p>
</div>
