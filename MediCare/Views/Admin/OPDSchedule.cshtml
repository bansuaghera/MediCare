@{
    ViewData["Title"] = "OPD Schedule";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .btn-add {
        background: #17b978;
        color: white;
        padding: 8px 15px;
        border-radius: 6px;
        border: none;
    }

    .card {
        background: white;
        padding: 20px;
        border-radius: 10px;
    }

    #calendar {
        margin-top: 10px;
    }
</style>

<div class="page-header">
    <div>
        <h2>OPD Schedule</h2>
        <small>Manage OPD schedules and slots</small>
    </div>
    <button class="btn-add">+ Add Schedule</button>
</div>

<div class="card">
    <div id="calendar"></div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        var calendarEl = document.getElementById('calendar');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            height: 600,
            selectable: true,

            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },

            dateClick: function (info) {
                alert("Selected Date: " + info.dateStr);
            },

            events: [
                {
                    title: 'Dr. Sarah Johnson (Room 101)',
                    start: '2026-02-14T09:00:00',
                    end: '2026-02-14T12:00:00'
                },
                {
                    title: 'Dr. Michael Chen (Room 102)',
                    start: '2026-02-15T10:00:00',
                    end: '2026-02-15T13:00:00'
                }
            ]
        });

        calendar.render();
    });
</script>