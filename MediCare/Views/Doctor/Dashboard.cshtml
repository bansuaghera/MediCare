@model MediCare.Models.ViewModels.DoctorDashboardViewModel
@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 30px;
    }

    .page-header h3 {
        font-weight: 700;
        margin-bottom: 4px;
        color: #1a1a1a;
        font-size: 24px;
    }

    .page-header p {
        color: #6b7280;
        font-size: 14px;
    }

    /* Stats Grid */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    @@media (min-width: 1200px) {
        .stats-row {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .stat-info h2 {
        font-size: 32px;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
        line-height: 1;
    }

    .stat-info p {
        margin: 8px 0 0 0;
        color: #6b7280;
        font-size: 14px;
        font-weight: 500;
        line-height: 1.4;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .icon-green { background: #d1fae5; color: #10b981; }
    .icon-blue { background: #dbeafe; color: #3b82f6; }
    .icon-purple { background: #f3e8ff; color: #a855f7; }
    .icon-orange { background: #ffedd5; color: #f97316; }

    /* Main Grid */
    .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 24px;
    }

    @@media (min-width: 992px) {
        .dashboard-grid {
            grid-template-columns: 2fr 1fr;
        }
    }

    .content-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .content-card h4 {
        font-size: 18px;
        font-weight: 700;
        color: #1a1a1a;
        margin-top: 0;
        margin-bottom: 24px;
    }

    /* Appointments List */
    .appointment-item {
        display: flex;
        align-items: center;
        padding: 16px;
        border: 1px solid #f1f5f9;
        border-radius: 12px;
        margin-bottom: 12px;
        transition: all 0.2s;
    }

    .appointment-item:hover {
        border-color: #e2e8f0;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }
    
    .appointment-item:last-child {
        margin-bottom: 0;
    }

    .time-slot {
        width: 100px;
        font-weight: 600;
        color: #1a1a1a;
        font-size: 14px;
    }

    .patient-details {
        flex: 1;
    }

    .patient-details h5 {
        margin: 0 0 4px 0;
        font-size: 15px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .patient-details p {
        margin: 0;
        font-size: 13px;
        color: #6b7280;
    }

    .status-badge {
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-in-progress { background: #eff6ff; color: #3b82f6; }
    .status-waiting { background: #fff7ed; color: #f97316; }
    .status-scheduled { background: #f8fafc; color: #64748b; }

    /* Quick Stats */
    .quick-stat-item {
        margin-bottom: 30px;
        padding-bottom: 24px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .quick-stat-item:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: none;
    }

    .quick-stat-label {
        font-size: 14px;
        color: #6b7280;
    }

    .quick-stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
        line-height: 1;
    }

    /* Progress Bar */
    .progress-container {
        margin-top: 30px;
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 13px;
    }

    .progress-title { color: #6b7280; font-weight: 500; }
    .progress-value { font-weight: 700; color: #10b981; }

    .progress-bar-bg {
        height: 6px;
        background: #f1f5f9;
        border-radius: 4px;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        background: #10b981;
        width: 33%;
        border-radius: 4px;
    }

    .small-chart-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        margin-top: 24px;
    }

    .small-chart-wrap {
        position: relative;
        width: 100%;
        height: 220px;
    }

    .detail-mini-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-top: 14px;
    }

    .detail-mini {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 12px 14px;
    }

    .detail-mini label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 3px;
    }

    .detail-mini span {
        font-size: 18px;
        font-weight: 800;
        color: #111827;
    }
</style>

<div class="page-header">
    <h3>Doctor Dashboard</h3>
    <p>Welcome back, @(Context.Session.GetString("UserName") ?? "Dr. Priya Patel") 👋</p>
</div>

<div class="stats-row">
    <div class="stat-card">
        <div class="stat-info">
            <h2>@Model.TodayAppointmentsCount</h2>
            <p>Today's<br/>Appointments</p>
        </div>
        <div class="stat-icon icon-green">
            <i class="fa-regular fa-calendar-check"></i>
        </div>
    </div>
    
    <div class="stat-card">
        <div class="stat-info">
            <h2>@Model.WaitingPatientsCount</h2>
            <p>Waiting<br/>Patients</p>
        </div>
        <div class="stat-icon icon-blue">
            <i class="fa-regular fa-user"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <h2>@Model.CompletedAppointmentsCount</h2>
            <p>Completed</p>
        </div>
        <div class="stat-icon icon-purple">
            <i class="fa-regular fa-circle-check"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <h2>@Model.TomorrowAppointmentsCount</h2>
            <p>Tomorrow</p>
        </div>
        <div class="stat-icon icon-orange">
            <i class="fa-regular fa-clock"></i>
        </div>
    </div>
</div>

<div class="content-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Today Status Analysis</h4>
        <a asp-action="Analytics" class="text-success text-decoration-none small fw-bold">Open Analytics</a>
    </div>
    <div class="small-chart-wrap">
        <canvas id="doctorStatusChart"></canvas>
    </div>
</div>

<div class="dashboard-grid">
    <div class="content-card">
        <h4>Today's Appointments</h4>
        
        <div class="appointment-list">
            @if (Model.TodayAppointments != null && Model.TodayAppointments.Any())
            {
                @foreach (var appointment in Model.TodayAppointments)
                {
                    <div class="appointment-item">
                        <div class="time-slot">@appointment.AppointmentDate.ToString("hh:mm tt")</div>
                        <div class="patient-details">
                            <h5>@(appointment.Patient?.FirstName + " " + appointment.Patient?.LastName)</h5>
                            <p>@appointment.Subject &bull; Token: @appointment.TokenNumber</p>
                        </div>
                        <div class="status-badge status-@(appointment.Status?.ToLower().Replace(" ", "-") ?? "scheduled")">
                            @appointment.Status
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <p>No appointments for today.</p>
                </div>
            }
        </div>
    </div>

    <div class="content-card">
        <h4>Quick Stats</h4>

        <div class="quick-stat-item">
            <div class="quick-stat-label">Total Patients</div>
            <div class="quick-stat-value">@Model.TotalPatientsCount</div>
        </div>

        <div class="quick-stat-item">
            <div class="quick-stat-label">Avg Consultation Time</div>
            <div class="quick-stat-value">18 min</div>
        </div>

        <div class="quick-stat-item" style="border-bottom: none; margin-bottom: 0; padding-bottom: 0;">
            <div class="quick-stat-label">Prescriptions Issued</div>
            <div class="quick-stat-value">@Model.PrescriptionsIssuedCount</div>
            
            <div class="progress-container">
                <div class="progress-header">
                    <span class="progress-title">Today's Progress</span>
                    <span class="progress-value">@Model.TodayProgressPercentage.ToString("0")%</span>
                </div>
                <div class="progress-bar-bg">
                    <div class="progress-bar-fill" style="width: @Model.TodayProgressPercentage.ToString("0")%;"></div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="small-chart-card">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="fw-bold mb-0" style="font-size:16px;">Visit Breakdown</h5>
        <span class="text-muted small">Real data</span>
    </div>
    <div class="small-chart-wrap" style="height:180px;">
        <canvas id="doctorMiniPie"></canvas>
    </div>
    <div class="detail-mini-grid">
        <div class="detail-mini">
            <label>Total Patients</label>
            <span>@Model.TotalPatientsCount</span>
        </div>
        <div class="detail-mini">
            <label>Waiting Today</label>
            <span>@Model.WaitingPatientsCount</span>
        </div>
        <div class="detail-mini">
            <label>Completed</label>
            <span>@Model.CompletedAppointmentsCount</span>
        </div>
        <div class="detail-mini">
            <label>Tomorrow</label>
            <span>@Model.TomorrowAppointmentsCount</span>
        </div>
    </div>
</div>

<div class="small-chart-card">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="fw-bold mb-0" style="font-size:16px;">Recent Today</h5>
        <a asp-action="Appointments" class="text-success text-decoration-none small fw-bold">Open Appointments</a>
    </div>
    @if (Model.TodayAppointments != null && Model.TodayAppointments.Any())
    {
        foreach (var item in Model.TodayAppointments.Take(3))
        {
            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                <div>
                    <div class="fw-semibold">@item.Patient?.FirstName @item.Patient?.LastName</div>
                    <div class="text-muted small">@item.Subject</div>
                </div>
                <div class="text-end">
                    <div class="fw-semibold">@item.TokenNumber</div>
                    <div class="text-muted small">@item.TimeSlot</div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-muted small">No appointments for today.</div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const doctorStatusCtx = document.getElementById('doctorStatusChart');
    if (doctorStatusCtx) {
        new Chart(doctorStatusCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.ChartLabels ?? new List<string>())),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(ViewBag.ChartData ?? new List<int>())),
                    backgroundColor: ['#f59e0b', '#3b82f6', '#10b981', '#ef4444']
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
        });
    }

    const doctorMiniPieCtx = document.getElementById('doctorMiniPie');
    if (doctorMiniPieCtx) {
        new Chart(doctorMiniPieCtx, {
            type: 'pie',
            data: {
                labels: ['Waiting', 'Completed', 'Tomorrow', 'Other'],
                datasets: [{
                    data: [
                        @Model.WaitingPatientsCount,
                        @Model.CompletedAppointmentsCount,
                        @Model.TomorrowAppointmentsCount,
                        Math.max(0, @Model.TodayAppointmentsCount - @Model.WaitingPatientsCount - @Model.CompletedAppointmentsCount)
                    ],
                    backgroundColor: ['#f59e0b', '#10b981', '#3b82f6', '#e2e8f0']
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
        });
    }
</script>
