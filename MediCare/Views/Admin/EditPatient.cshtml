@model MediCare.Models.Patient
@{
    ViewData["Title"] = "Edit Patient";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .patient-container {
        max-width: 1100px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .page-header h2 {
            font-weight: 700;
        }

    .card-box {
        background: white;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    }

    .form-row {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .form-group {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 250px;
    }

        .form-group label {
            font-weight: 600;
            margin-bottom: 6px;
            font-size: 14px;
        }

    .form-control {
        border-radius: 10px;
        padding: 10px 14px;
        border: 1px solid #e5e5e5;
    }

    textarea.form-control {
        resize: none;
    }

    .btn-save {
        background: #16a34a;
        color: white;
        padding: 10px 22px;
        border-radius: 10px;
        border: none;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(22,163,74,0.3);
        margin-right: 10px;
    }

    .btn-cancel {
        background: #f3f4f6;
        padding: 10px 22px;
        border-radius: 10px;
        border: none;
    }

    @@media (max-width: 768px) {
        .save-btn {
            width: 100%;
            float: none;
            margin-top: 20px;
        }
    }
</style>

<div class="patient-container">

    <div class="page-header">
        <div>
            <h2>Edit Patient</h2>
            <p class="text-muted mb-0">Update patient details</p>
        </div>
    </div>

    <div class="card-box">
        <form method="post" asp-action="EditPatient">
            <input type="hidden" asp-for="Id" />

            <div class="form-row">
                <div class="form-group">
                    <label>First Name *</label>
                    <input type="text" asp-for="FirstName" class="form-control" placeholder="Enter first name" required />
                </div>

                <div class="form-group">
                    <label>Last Name *</label>
                    <input type="text" asp-for="LastName" class="form-control" placeholder="Enter last name" required />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Date of Birth *</label>
                    <input type="date" asp-for="DateOfBirth" class="form-control" required />
                </div>

                <div class="form-group">
                    <label>Gender *</label>
                    <select asp-for="Gender" class="form-control">
                        <option value="">Select gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Blood Group</label>
                    <select asp-for="BloodGroup" class="form-control">
                        <option value="">Select blood group</option>
                        <option value="A+">A+</option>
                        <option value="B+">B+</option>
                        <option value="O+">O+</option>
                        <option value="AB+">AB+</option>
                        <option value="A-">A-</option>
                        <option value="B-">B-</option>
                        <option value="O-">O-</option>
                        <option value="AB-">AB-</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Phone Number *</label>
                    <input type="text" asp-for="Phone" class="form-control" placeholder="+91 00000 00000" required />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input type="email" asp-for="Email" class="form-control" placeholder="patient@example.com" />
                </div>
            </div>

            <div class="form-group mb-3">
                <label>Address</label>
                <input type="text" asp-for="Address" class="form-control" placeholder="Enter full address" />
            </div>

            <div class="form-group">
                <label>Medical History</label>
                <textarea rows="4" asp-for="MedicalHistory" class="form-control"></textarea>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn-save">
                    <i class="fa-solid fa-save me-2"></i> Save Changes
                </button>

                <a asp-action="Patient" class="btn-cancel text-decoration-none text-dark">
                    Cancel
                </a>
            </div>

        </form>
    </div>

</div>
