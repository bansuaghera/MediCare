@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Register - MediCare+</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI';
        }

        .container-login {
            display: flex;
            height: 100vh;
        }

        .left {
            flex: 1;
            background: linear-gradient(135deg,#16a34a,#14b8a6);
            color: white;
            padding: 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .right {
            flex: 1;
            background: #f4f6f9;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card-box {
            width: 450px;
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.1);
        }

        .form-control {
            height: 45px;
            border-radius: 10px;
        }

        .btn-custom {
            background: linear-gradient(135deg,#16a34a,#14b8a6);
            border: none;
            height: 45px;
            border-radius: 10px;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="container-login">

        <div class="left">
            <h1>Join Our Healthcare Platform</h1>
            <p class="mt-4">
                Create your account and get access to our
                comprehensive healthcare management system.
            </p>

            <ul class="mt-4">
                <li>Book appointments instantly</li>
                <li>Access medical records anytime</li>
                <li>Track your health journey</li>
            </ul>
        </div>

        <div class="right">

            <div class="card-box">
                <h3 class="text-center mb-3">Create Account</h3>
                <p class="text-center text-muted">Register for MediCare Smart OPD</p>

                <form asp-controller="Login" asp-action="Register" method="post">

                    <div class="row mb-3">
                        <div class="col">
                            <input type="text" name="FirstName" class="form-control" placeholder="First Name" required />
                        </div>
                        <div class="col">
                            <input type="text" name="LastName" class="form-control" placeholder="Last Name" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <input type="email" name="Email" class="form-control" placeholder="Email Address" required />
                    </div>

                    <div class="mb-3">
                        <input type="number" name="phone" class="form-control" placeholder="Phone Number" required />
                    </div>

                    <div class="mb-3">
                        <input type="password" name="Password" class="form-control" placeholder="Create Password" required />
                    </div>

                    <div class="mb-3">
                        <input type="password" name="Confirm Password" class="form-control" placeholder="Confirm Password" required />
                    </div>


                    <button type="submit" class="btn btn-custom w-100 text-white">
                        Create Account
                    </button>

                    <div class="text-center mt-3">
                        Already have an account?
                        <a asp-controller="Login" asp-action="Login" class="text-success">Login</a>
                    </div>

                </form>
            </div>

        </div>

    </div>

</body>
</html>