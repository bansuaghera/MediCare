@{
    ViewData["Title"] = "Analytics";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Analytics</h2>
        <p class="text-muted mb-0">Real DB-backed overview of clinic activity</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm rounded-4 p-3"><small class="text-muted">Patients</small><h3 class="fw-bold mb-0">@ViewBag.TotalPatients</h3></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm rounded-4 p-3"><small class="text-muted">Doctors</small><h3 class="fw-bold mb-0">@ViewBag.ActiveDoctors</h3></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm rounded-4 p-3"><small class="text-muted">Appointments</small><h3 class="fw-bold mb-0">@ViewBag.TotalAppointments</h3></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm rounded-4 p-3"><small class="text-muted">Emergency</small><h3 class="fw-bold mb-0">@ViewBag.EmergencyCount</h3></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold mb-3">Appointment Trend</h5>
            <canvas id="analyticsLine" height="120"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold mb-3">Status Mix</h5>
            <canvas id="analyticsDoughnut" height="240"></canvas>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 mt-4">
    <h5 class="fw-bold mb-3">Recent Appointments</h5>
    @if (ViewBag.RecentAppointments != null)
    {
        foreach (var appt in (IEnumerable<MediCare.Models.Appointment>)ViewBag.RecentAppointments)
        {
            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                <div>
                    <div class="fw-semibold">@appt.Patient?.FirstName @appt.Patient?.LastName</div>
                    <div class="text-muted small">Dr. @appt.Doctor?.FirstName @appt.Doctor?.LastName</div>
                </div>
                <div class="text-end">
                    <div class="fw-semibold">@appt.TokenNumber</div>
                    <div class="text-muted small">@appt.AppointmentDate.ToString("dd MMM yyyy")</div>
                </div>
            </div>
        }
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    new Chart(document.getElementById('analyticsLine'), {
        type: 'line',
        data: {
            labels: @Html.Raw(Json.Serialize(ViewBag.ChartLabels ?? new List<string>())),
            datasets: [{
                label: 'Appointments',
                data: @Html.Raw(Json.Serialize(ViewBag.ChartData ?? new List<int>())),
                borderColor: '#10b981',
                backgroundColor: 'rgba(16,185,129,0.12)',
                fill: true,
                tension: 0.35
            }]
        },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
    });

    new Chart(document.getElementById('analyticsDoughnut'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(Json.Serialize(ViewBag.StatusLabels ?? new List<string>())),
            datasets: [{
                data: @Html.Raw(Json.Serialize(ViewBag.StatusData ?? new List<int>())),
                backgroundColor: ['#f59e0b', '#3b82f6', '#10b981', '#ef4444']
            }]
        },
        options: { plugins: { legend: { position: 'bottom' } } }
    });
</script>
