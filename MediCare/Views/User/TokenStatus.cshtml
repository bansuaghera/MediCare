@{
    ViewData["Title"] = "Token Status";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<style>
    .page-header h2 {
        font-weight: 700;
    }

    .token-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 40px;
    }

    .token-card {
        background: #ffffff;
        padding: 35px;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.08);
        width: 100%;
        max-width: 520px;
        transition: 0.3s;
    }

        .token-card:hover {
            transform: translateY(-4px);
        }

    .token-title {
        text-align: center;
        color: #6b7280;
        font-size: 14px;
        margin-bottom: 15px;
    }

    .token-number {
        background: #d1fae5;
        color: #065f46;
        text-align: center;
        font-size: 48px;
        font-weight: 800;
        padding: 25px;
        border-radius: 15px;
        margin-bottom: 25px;
    }

    .info-box {
        background: #f9fafb;
        padding: 14px 18px;
        border-radius: 12px;
        margin-bottom: 12px;
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        color: #374151;
    }

        .info-box i {
            margin-right: 6px;
            color: #6b7280;
        }

    .status-box {
        background: #d1fae5;
        padding: 20px;
        border-radius: 15px;
        text-align: center;
        margin-top: 25px;
        border: 1px solid #a7f3d0;
    }

        .status-box h5 {
            margin: 0;
            font-weight: 700;
            color: #065f46;
        }

        .status-box small {
            color: #047857;
        }

    @@media (max-width: 768px) {
        .token-number {
            font-size: 36px;
        }
    }
</style>

<div class="page-header">
    <h2>Token Status</h2>
    <p class="text-muted">Check your live queue status</p>
</div>

<div class="token-wrapper">
    <div class="token-card">

        <div class="token-title">Your Token Number</div>

        <div class="token-number">
            A-045
        </div>

        <div class="info-box">
            <div><i class="fa fa-user"></i> Patient</div>
            <div>Rahul Sharma</div>
        </div>

        <div class="info-box">
            <div><i class="fa fa-user-doctor"></i> Doctor</div>
            <div>Dr. Priya Patel</div>
        </div>

        <div class="info-box">
            <div><i class="fa fa-clock"></i> Est. Wait Time</div>
            <div style="color:#059669;font-weight:600;">~15 minutes</div>
        </div>

        <div class="status-box">
            <h5>Status: Waiting</h5>
            <small>4 patients ahead of you</small>
        </div>

    </div>
</div>