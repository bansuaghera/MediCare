@{
    ViewData["Title"] = "Staff Dashboard";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<style>
    .stat-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stat-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .icon-green {
        background: #d1fae5;
        color: #16a34a;
    }

    .icon-purple {
        background: #ede9fe;
        color: #7c3aed;
    }

    .icon-pink {
        background: #fce7f3;
        color: #db2777;
    }

    .icon-orange {
        background: #ffedd5;
        color: #ea580c;
    }

    .card-box {
        background: #ffffff;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    }

    .quick-btn {
        width: 100%;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 12px;
    }

    .appointment-item {
        border: 1px solid #f0f0f0;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .appointment-time {
        font-weight: 600;
    }

    .appointment-code {
        color: #16a34a;
        font-weight: 600;
    }
</style>

<h3 class="fw-bold">Staff Dashboard</h3>
<p class="text-muted">Welcome back! Here's today's overview</p>

<!-- Stats Row -->
<div class="row g-4 mt-2">

    <div class="col-md-3">
        <div class="stat-card">
            <div>
                <small class="text-muted">Today's Appointments</small>
                <h4 class="fw-bold mb-0">38</h4>
            </div>
            <div class="stat-icon icon-green">
                <i class="fa fa-calendar-check"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div>
                <small class="text-muted">Active Tokens</small>
                <h4 class="fw-bold mb-0">12</h4>
            </div>
            <div class="stat-icon icon-purple">
                <i class="fa fa-ticket"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div>
                <small class="text-muted">New Patients</small>
                <h4 class="fw-bold mb-0">5</h4>
            </div>
            <div class="stat-icon icon-pink">
                <i class="fa fa-user-plus"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div>
                <small class="text-muted">Scheduled Tomorrow</small>
                <h4 class="fw-bold mb-0">42</h4>
            </div>
            <div class="stat-icon icon-orange">
                <i class="fa fa-clock"></i>
            </div>
        </div>
    </div>

</div>

<div class="row mt-4 g-4">

    <!-- Quick Actions -->
    <div class="col-md-4">
        <div class="card-box">
            <h5 class="fw-bold mb-3">Quick Actions</h5>

            <a asp-action="RegisterPatient" class="btn btn-success quick-btn">
                <i class="fa fa-user-plus me-2"></i> Register Patient
            </a>

            <button class="btn btn-outline-secondary quick-btn">
                <i class="fa fa-calendar me-2"></i> Book Appointment
            </button>

            <button class="btn btn-outline-secondary quick-btn">
                <i class="fa fa-ticket me-2"></i> Generate Token
            </button>
        </div>
    </div>

    <!-- Today's Appointments -->
    <div class="col-md-8">
        <div class="card-box">
            <h5 class="fw-bold mb-3">Today's Appointments</h5>

            <div class="appointment-item">
                <div>
                    <div class="appointment-time">09:00 AM</div>
                    John Smith <br />
                    <small class="text-muted">Dr. Sarah Johnson</small>
                </div>
                <div class="appointment-code">A-045</div>
            </div>

            <div class="appointment-item">
                <div>
                    <div class="appointment-time">09:30 AM</div>
                    Sarah Johnson <br />
                    <small class="text-muted">Dr. Michael Chen</small>
                </div>
                <div class="appointment-code">A-046</div>
            </div>

            <div class="appointment-item">
                <div>
                    <div class="appointment-time">10:00 AM</div>
                    Michael Chen <br />
                    <small class="text-muted">Dr. Emily Davis</small>
                </div>
                <div class="appointment-code">A-047</div>
            </div>

            <div class="appointment-item">
                <div>
                    <div class="appointment-time">10:30 AM</div>
                    Emily Davis <br />
                    <small class="text-muted">Dr. Robert Wilson</small>
                </div>
                <div class="appointment-code">A-048</div>
            </div>

        </div>
    </div>

</div>