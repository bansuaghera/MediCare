@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Forgot Password - MediCare+</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI';
        }

        .container-box {
            display: flex;
            height: 100vh;
        }

        .left {
            flex: 1;
            background: linear-gradient(135deg,#16a34a,#14b8a6);
            color: white;
            padding: 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .right {
            flex: 1;
            background: #f4f6f9;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card-box {
            width: 420px;
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.1);
        }

        .form-control {
            height: 45px;
            border-radius: 10px;
        }

        .btn-custom {
            background: linear-gradient(135deg,#16a34a,#14b8a6);
            border: none;
            height: 45px;
            border-radius: 10px;
            font-weight: 600;
        }

        .step-box {
            margin-top: 30px;
        }

            .step-box div {
                margin-bottom: 15px;
            }
    </style>
</head>

<body>

    <div class="container-box">

        <!-- LEFT SIDE -->
        <div class="left">
            <h1>Don't Worry!</h1>
            <p class="mt-4">
                Forgot your password? No problem! We'll send you a reset
                link to get you back into your account quickly and securely.
            </p>

            <div class="step-box">
                <div><strong>1.</strong> Enter your email</div>
                <div><strong>2.</strong> Check your inbox</div>
                <div><strong>3.</strong> Create new password</div>
            </div>
        </div>

        <!-- RIGHT SIDE -->
        <div class="right">

            <div class="card-box text-center">

                <div class="mb-3">
                    <i class="fa-solid fa-envelope fa-2x text-success"></i>
                </div>

                <h3>Forgot Password?</h3>
                <p class="text-muted">
                    Enter your email address and we'll send instructions to reset your password.
                </p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success">@ViewBag.Success</div>
                }

                <form asp-controller="Login" asp-action="ForgotPassword" method="post">

                    <div class="mb-3 text-start">
                        <label>Email Address</label>
                        <input type="email" name="Email" class="form-control" placeholder="Enter your email" required />
                    </div>

                    <button type="submit" class="btn btn-custom w-100 text-white">
                        <i class="fa-solid fa-paper-plane me-2"></i>
                        Send Reset Link
                    </button>

                    <div class="mt-3">
                        <a asp-controller="Login" asp-action="Login" class="text-dark">
                            ← Back to Login
                        </a>
                    </div>

                </form>

            </div>

        </div>

    </div>

</body>
</html>