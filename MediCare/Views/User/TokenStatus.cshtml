@model MediCare.Models.Appointment
@{
    ViewData["Title"] = "Token Queue Monitor";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<style>
    .queue-monitor-card {
        background: white;
        border-radius: 30px;
        padding: 50px;
        border: 1px solid #f1f5f9;
        text-align: center;
        box-shadow: 0 30px 60px rgba(16, 185, 129, 0.08);
        position: relative;
        overflow: hidden;
    }
    .queue-monitor-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 8px;
        background: linear-gradient(90deg, #10b981 0%, #3b82f6 100%);
    }
    .main-token-circle {
        width: 180px;
        height: 180px;
        background: #f0fdf4;
        border: 10px solid #d1fae5;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin: 0 auto 30px;
        animation: pulseSubtle 2s infinite ease-in-out;
    }
    @@keyframes pulseSubtle {
        0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.1); }
        70% { box-shadow: 0 0 0 40px rgba(16, 185, 129, 0); }
        100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
    .token-label { font-size: 11px; font-weight: 800; text-transform: uppercase; color: #10b981; margin-bottom: 5px; }
    .token-num { font-size: 52px; font-weight: 800; color: #065f46; }

    .wait-stat {
        background: #f8fafc;
        border-radius: 20px;
        padding: 15px 30px;
        display: inline-flex;
        align-items: center;
        gap: 15px;
    }
    .wait-stat i { color: #f59e0b; }
</style>

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="fw-bold m-0"><i class="fa fa-ticket text-success me-2"></i> Live Queue Tracking</h1>
        <p class="text-muted">Stay updated on your clinic session status in real-time</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        @if (Model != null)
        {
            <div class="queue-monitor-card">
                <div class="mb-5">
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-4 py-2 border mb-3">
                        <i class="fa-solid fa-satellite-dish me-2"></i> LIVE CONNECTION ACTIVE
                    </span>
                    <h2 class="fw-bold m-0">@Model.Doctor?.FirstName @Model.Doctor?.LastName's Desk</h2>
                    <p class="text-muted small">Specialty: @Model.Doctor?.Specialty</p>
                </div>

                <div class="main-token-circle">
                    <div class="token-label">Your Token</div>
                    <div class="token-num">@Model.TokenNumber</div>
                </div>

                <div class="mb-5">
                    <h5 class="fw-bold m-0">Position in Queue: <span class="text-success">@((ViewBag.PatientsAhead ?? 0) + 1)</span></h5>
                    <p class="text-muted small">Estimated entry in roughly @((ViewBag.PatientsAhead ?? 0) * 15) mins</p>
                </div>

                <div class="d-flex justify-content-center gap-3 mb-4">
                    <div class="wait-stat border">
                        <i class="fa-regular fa-clock fa-lg"></i>
                        <div class="text-start">
                            <div class="small fw-bold text-muted text-uppercase">Wait Capacity</div>
                            <div class="fw-bold">@(ViewBag.PatientsAhead ?? 0) Patients Ahead</div>
                        </div>
                    </div>
                    <div class="wait-stat border">
                        <i class="fa-regular fa-calendar-check fa-lg"></i>
                        <div class="text-start">
                            <div class="small fw-bold text-muted text-uppercase">Status</div>
                            <div class="fw-bold text-success">@Model.Status</div>
                        </div>
                    </div>
                </div>

                <div class="alert bg-blue-50 border-0 rounded-4 p-4 d-flex align-items-center gap-3">
                    <i class="fa-solid fa-circle-exclamation text-blue-600 fa-lg"></i>
                    <p class="m-0 text-start small fw-medium text-blue-800">Please arrive at the clinic desk at least 15 minutes prior to your estimated entry time.</p>
                </div>
            </div>
        }
        else
        {
            <div class="queue-monitor-card py-5">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
                    <i class="fa-solid fa-calendar-xmark fa-3x opacity-25"></i>
                </div>
                <h4 class="fw-bold">No Active Session</h4>
                <p class="text-muted">You don't have an appointment scheduled for today.<br/>Join the queue to monitor your status.</p>
                <div class="mt-4 row g-2">
                    <div class="col-6"><a asp-action="BookAppointment" class="btn btn-emerald-luxury w-100 rounded-pill py-3 fw-bold">Book For Today</a></div>
                    <div class="col-6"><a asp-action="Doctors" class="btn btn-light border w-100 rounded-pill py-3 fw-bold">Find Doctor</a></div>
                </div>
            </div>
        }
    </div>
</div>