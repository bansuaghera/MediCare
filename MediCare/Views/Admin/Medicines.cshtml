@model IEnumerable<MediCare.Models.Medicine>
@{
    ViewData["Title"] = "Medicine Master";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
        align-items: center;
        gap: 8px;
        text-decoration: none;
        box-shadow: 0 6px 18px rgba(34,197,94,0.35);
        transition: all 0.3s ease;
    }

        .add-btn:hover {
            background: linear-gradient(135deg, #16a34a, #15803d);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(34,197,94,0.45);
        }

    .card-box {
        background: white;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        overflow-x: auto;
    }

    .search-box {
        width: 100%;
        max-width: 400px;
        padding: 10px 15px;
        border-radius: 10px;
        border: 1px solid #e5e5e5;
        margin-bottom: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px;
    }

    thead {
        background: #f9fafb;
    }

    table th {
        padding: 14px 10px;
        font-size: 13px;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: left;
    }

    table td {
        padding: 14px 10px;
        border-top: 1px solid #f1f1f1;
        font-weight: 500;
    }

    .actions {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .actions i {
        cursor: pointer;
        color: #374151;
        transition: 0.2s;
    }

        .actions i:hover {
            color: #16a34a;
        }

        .actions button {
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
        }

        .actions button i:hover {
            color: red;
        }

    .pagination-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        color: #6b7280;
        flex-wrap: wrap;
    }

        .pagination-box button {
            padding: 6px 14px;
            border-radius: 8px;
            border: 1px solid #ddd;
            background: white;
            margin-left: 8px;
            transition: 0.2s;
        }

            .pagination-box button:hover {
                background: #f3f4f6;
            }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .add-btn {
            width: 100%;
            justify-content: center;
        }

        table {
            font-size: 13px;
        }
    }
</style>

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h2>Medicine Master</h2>
        <p class="text-muted mb-0">Manage medicine inventory</p>
    </div>

    <a asp-controller="Admin"
       asp-action="AddMedicine"
       class="add-btn">
        <i class="fa-solid fa-plus"></i> Add Medicine
    </a>
</div>

<!-- TABLE CARD -->
<div class="card-box">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <input type="text" class="search-box" placeholder="Search medicines..." style="margin-bottom: 0;" />
        <form asp-action="DeleteAllMedicines" method="post" onsubmit="return confirm('WARNING: Are you sure you want to delete ALL medicines? This cannot be undone.');">
            <button type="submit" class="btn btn-danger" style="border-radius: 8px; padding: 6px 15px;">Delete All</button>
        </form>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Medicine Name</th>
                <th>Category</th>
                <th>Stock</th>
                <th>Selling Price</th>
                <th>Company</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach(var medicine in Model)
            {
                <tr>
                    <td>#MED-@(medicine.Id.ToString("D3"))</td>
                    <td>@medicine.MedicineName</td>
                    <td>@medicine.Category</td>
                    <td>@medicine.Stock units</td>
                    <td>$@medicine.SellingPrice.ToString("0.00")</td>
                    <td>@medicine.Manufacturer</td>
                    <td class="actions">
                        <a asp-action="EditMedicine" asp-route-id="@medicine.Id" style="color: inherit;" title="Edit"><i class="fa-solid fa-pen-to-square"></i></a>
                        <form asp-action="DeleteMedicine" asp-route-id="@medicine.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this medicine?');">
                            <button type="submit" title="Delete"><i class="fa-solid fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination-box">
        <div>Showing 5 results</div>
        <div>
            <button>Previous</button>
            <button>Next</button>
        </div>
    </div>

</div>
