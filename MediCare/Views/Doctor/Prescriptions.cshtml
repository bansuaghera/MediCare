@model IEnumerable<MediCare.Models.Prescription>
@{
    ViewData["Title"] = "Prescriptions";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 30px;
    }
    .page-header h3 {
        font-weight: 700;
        margin-bottom: 4px;
        color: #1a1a1a;
        font-size: 24px;
    }
    .page-header p {
        color: #6b7280;
        font-size: 14px;
    }

    .table-card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }
    
    .search-box {
        background: #f8fafc;
        border: 1px solid transparent;
        border-radius: 24px;
        padding: 12px 20px;
        display: flex;
        align-items: center;
        width: 320px;
        margin-bottom: 30px;
        transition: 0.3s;
    }
    .search-box:focus-within {
        border-color: #10b981;
        background: #fff;
    }
    .search-box i {
        color: #9ca3af;
        margin-right: 12px;
        font-size: 14px;
    }
    .search-box input {
        border: none;
        background: transparent;
        outline: none;
        width: 100%;
        color: #1a1a1a;
        font-size: 14px;
    }

    .table {
        margin-bottom: 0;
        width: 100%;
        border-collapse: collapse;
    }
    
    .table thead {
        background-color: #f8fafc;
    }

    .table th {
        color: #6b7280;
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: none;
        padding: 16px 20px;
        text-align: left;
    }
    
    .table th:first-child { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
    .table th:last-child { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }

    .table td {
        padding: 20px;
        vertical-align: middle;
        font-size: 13px;
        color: #4b5563;
        border-bottom: 1px solid #f8fafc;
    }
    .table tr:last-child td { border-bottom: none; }

    .patient-name {
        font-weight: 600;
        color: #1a1a1a;
        font-size: 14px;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: white;
        color: #1a1a1a;
        border: 1px solid #e5e5e5;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }
    .action-btn:hover {
        background: #f8fafc;
        color: #10b981;
        border-color: #10b981;
    }

    .pagination-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 30px;
        font-size: 13px;
        color: #6b7280;
    }
    
    .paginate-btn {
        background: white;
        border: 1px solid #e5e5e5;
        padding: 8px 16px;
        border-radius: 8px;
        color: #4b5563;
        font-weight: 500;
        margin-left: 8px;
        transition: 0.2s;
        cursor: pointer;
        font-size: 13px;
    }
    .paginate-btn:hover {
        background: #f8fafc;
        color: #1a1a1a;
    }
</style>

<div class="page-header">
    <h3>My Prescriptions</h3>
    <p>View all prescriptions</p>
</div>

<div class="table-card">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="search-box mb-0">
            <i class="fa-solid fa-search"></i>
            <input type="text" id="searchInput" placeholder="Search prescriptions..." />
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary btn-sm" id="selectAllBtn">Select All</button>
            <button class="btn btn-outline-danger btn-sm d-none" id="deleteSelectedBtn" onclick="deleteSelected()">Delete Selected</button>
            <button class="btn btn-outline-danger btn-sm @(Model.Any() ? "" : "disabled")" onclick="deleteAll()">Delete All</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th style="width:36px;"><input type="checkbox" id="selectAll" class="form-check-input shadow-none" /></th>
                    <th>ID</th>
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Diagnosis</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var p in Model)
                {
                    <tr data-id="@p.Id">
                        <td><input type="checkbox" class="form-check-input row-check shadow-none" /></td>
                        <td>#PR-@(p.Id.ToString("D3"))</td>
                        <td class="patient-name">@(p.Patient != null ? $"{p.Patient.FirstName} {p.Patient.LastName}" : "Unknown")</td>
                        <td>@p.DateIssued.ToString("yyyy-MM-dd")</td>
                        <td>@(p.Diagnosis != null && p.Diagnosis.Length > 30 ? p.Diagnosis.Substring(0, 30) + "..." : p.Diagnosis)</td>
                        <td class="d-flex gap-2">
                            <button type="button" class="action-btn text-decoration-none" title="View Prescription" onclick="viewPrescription(@p.Id)">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                            <a asp-action="PrintPrescription" asp-route-id="@p.Id" class="action-btn text-decoration-none" title="Download/Print"><i class="fa-solid fa-print"></i></a>
                            <button class="action-btn text-danger" title="Delete" onclick="deleteOne(@p.Id)"><i class="fa-regular fa-trash-can"></i></button>
                        </td>
                    </tr>
                }
                @if(!Model.Any())
                {
                    <tr><td colspan="5" style="text-align:center; padding: 20px;">No prescriptions found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination-bar">
        <span>Showing <strong style="color: #1a1a1a;" id="resultCount">@Model.Count()</strong> results</span>
        <div>
            <button class="paginate-btn">Previous</button>
            <button class="paginate-btn">Next</button>
        </div>
    </div>
</div>

<div class="modal fade" id="prescriptionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold mb-1">Prescription Details</h5>
                    <div class="text-muted small" id="prescMeta">Loading...</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="small text-uppercase text-muted fw-bold">Patient</div>
                        <div class="fw-semibold" id="prescPatient">-</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-uppercase text-muted fw-bold">Doctor</div>
                        <div class="fw-semibold" id="prescDoctor">-</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-uppercase text-muted fw-bold">Token</div>
                        <div class="fw-semibold text-success" id="prescToken">-</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-uppercase text-muted fw-bold">Prescription ID</div>
                        <div class="fw-semibold" id="prescId">-</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-uppercase text-muted fw-bold">Date Issued</div>
                        <div class="fw-semibold" id="prescDate">-</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-uppercase text-muted fw-bold">Actions</div>
                        <a href="#" id="prescPrintLink" class="btn btn-sm btn-outline-success rounded-pill px-3 mt-1">Print</a>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="small text-uppercase text-muted fw-bold mb-2">Diagnosis</div>
                    <div class="p-3 rounded-4 bg-light" id="prescDiagnosis">-</div>
                </div>

                <div class="mb-3">
                    <div class="small text-uppercase text-muted fw-bold mb-2">Medicines</div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Medicine</th>
                                    <th>Dosage</th>
                                    <th>Food</th>
                                    <th>Instruction</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody id="prescMedicines">
                                <tr><td colspan="5" class="text-muted">No medicines available.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div>
                    <div class="small text-uppercase text-muted fw-bold mb-2">Additional Notes</div>
                    <div class="p-3 rounded-4 bg-light" id="prescNotes">-</div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('searchInput');
        const rows = document.querySelectorAll('tbody tr[data-id]');
        const selectAll = document.getElementById('selectAll');
        const selectAllBtn = document.getElementById('selectAllBtn');
        const deleteSelectedBtn = document.getElementById('deleteSelectedBtn');

        function filter() {
            const term = (searchInput?.value || '').toLowerCase();
            let count = 0;
            rows.forEach(r => {
                const visible = r.innerText.toLowerCase().includes(term);
                r.style.display = visible ? '' : 'none';
                if (visible) count++;
            });
            document.getElementById('resultCount').textContent = count;
        }
        if (searchInput) searchInput.addEventListener('input', filter);

        function syncBulk() {
            const checked = document.querySelectorAll('.row-check:checked').length;
            deleteSelectedBtn?.classList.toggle('d-none', checked === 0);
            if (selectAllBtn) selectAllBtn.textContent = checked === rows.length && rows.length > 0 ? 'Clear All' : 'Select All';
        }

        rows.forEach(r => r.querySelector('.row-check')?.addEventListener('change', syncBulk));
        if (selectAll) selectAll.addEventListener('change', () => {
            rows.forEach(r => r.querySelector('.row-check').checked = selectAll.checked);
            syncBulk();
        });
        if (selectAllBtn) selectAllBtn.addEventListener('click', () => {
            const all = Array.from(rows).every(r => r.querySelector('.row-check').checked);
            rows.forEach(r => r.querySelector('.row-check').checked = !all);
            if (selectAll) selectAll.checked = !all;
            syncBulk();
        });

        function deleteOne(id) {
            if (!confirm('Delete this prescription?')) return;
            $.post('/Doctor/DeletePrescription', { id }, res => { if (res.success) location.reload(); });
        }

        function parseMedicineNotes(raw) {
            if (!raw) return [];
            try {
                const parsed = JSON.parse(raw);
                if (Array.isArray(parsed)) return parsed;
            } catch (e) { }

            return raw.split('\n').filter(Boolean).map(line => {
                const parts = line.split('|');
                return {
                    name: parts[0] || line,
                    dosage: parts[1] || '-',
                    instruction: parts[2] || '-',
                    food: parts[3] || '-',
                    duration: parts[4] || '-'
                };
            });
        }

        function viewPrescription(id) {
            $('#prescriptionModal').modal('show');
            $('#prescMeta').text('Loading prescription ' + id + '...');
            $.get('/Doctor/GetPrescriptionDetails/' + id, function (res) {
                $('#prescMeta').text('#PR-' + String(res.id).padStart(3, '0'));
                $('#prescPatient').text(res.patientName || '-');
                $('#prescDoctor').text(res.doctorName || '-');
                $('#prescToken').text(res.token || '-');
                $('#prescId').text('#PR-' + String(res.id).padStart(3, '0'));
                $('#prescDate').text(res.dateIssued || '-');
                $('#prescDiagnosis').text(res.diagnosis || '-');
                $('#prescNotes').text(res.additionalNotes || '-');
                $('#prescPrintLink').attr('href', '/Doctor/PrintPrescription/' + id);

                const medicines = parseMedicineNotes(res.medicineNotes);
                if (medicines.length === 0) {
                    $('#prescMedicines').html('<tr><td colspan="5" class="text-muted">No medicines available.</td></tr>');
                } else {
                    let rows = '';
                    medicines.forEach(m => {
                        rows += `<tr>
                            <td class="fw-semibold">${m.name || '-'}</td>
                            <td>${m.dosage || '-'}</td>
                            <td>${m.food || '-'}</td>
                            <td>${m.instruction || '-'}</td>
                            <td>${m.duration || '-'}</td>
                        </tr>`;
                    });
                    $('#prescMedicines').html(rows);
                }
            });
        }

        function deleteSelected() {
            const ids = Array.from(document.querySelectorAll('.row-check:checked')).map(cb => parseInt(cb.closest('tr').dataset.id));
            if (ids.length === 0) return;
            if (!confirm(`Delete ${ids.length} selected prescription(s)?`)) return;
            $.ajax({
                url: '/Doctor/BulkDeletePrescriptions',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(ids),
                success: res => { if (res.success) location.reload(); }
            });
        }

        function deleteAll() {
            if (!confirm('Delete ALL prescriptions?')) return;
            const ids = Array.from(rows).map(r => parseInt(r.dataset.id));
            $.ajax({
                url: '/Doctor/BulkDeletePrescriptions',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(ids),
                success: res => { if (res.success) location.reload(); }
            });
        }

        filter();
        syncBulk();
    </script>
}
