@model MediCare.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold">Welcome back, @(Context.Session.GetString("UserName") ?? "Admin")! 👋</h2>
        <p class="text-muted">Overview of your clinic operations</p>
    </div>
</div>

<!-- STATS CARDS -->
<div class="row g-4 mb-4">

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-4 p-3">
            <div class="d-flex justify-content-between">
                <div>
                    <small class="text-muted">Total Patients</small>
                    <h3 class="fw-bold">@Model.TotalPatients</h3>
                </div>
                <div class="bg-success bg-opacity-25 p-3 rounded-3">
                    <i class="fa-solid fa-users text-success"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-4 p-3">
            <div class="d-flex justify-content-between">
                <div>
                    <small class="text-muted">Appointments Today</small>
                    <h3 class="fw-bold">@Model.AppointmentsToday</h3>
                </div>
                <div class="bg-primary bg-opacity-25 p-3 rounded-3">
                    <i class="fa-solid fa-calendar-check text-primary"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-4 p-3">
            <div class="d-flex justify-content-between">
                <div>
                    <small class="text-muted">Active Doctors</small>
                    <h3 class="fw-bold">@Model.ActiveDoctors</h3>
                </div>
                <div class="bg-purple bg-opacity-25 p-3 rounded-3">
                    <i class="fa-solid fa-user-doctor text-warning"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 rounded-4 p-3">
            <div class="d-flex justify-content-between">
                <div>
                    <small class="text-muted">Revenue</small>
                    <h3 class="fw-bold">₹@Model.TotalRevenue.ToString("N0")</h3>
                </div>
                <div class="bg-warning bg-opacity-25 p-3 rounded-3">
                    <i class="fa-solid fa-dollar-sign text-warning"></i>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- CHARTS -->
<div class="row g-4 mb-4">

    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <h5>Weekly Patients</h5>
            <canvas id="barChart"></canvas>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <h5>Appointment Trends</h5>
            <canvas id="lineChart"></canvas>
        </div>
    </div>

</div>

<!-- RECENT ACTIVITIES -->
<div class="card shadow-sm border-0 rounded-4 p-4">
    <h5 class="mb-4">Recent Appointments</h5>

    <div class="py-3">
        @if (Model.RecentAppointments != null && Model.RecentAppointments.Any())
        {
            @foreach (var appt in Model.RecentAppointments)
            {
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 p-2 rounded-circle me-3">
                        <i class="fa-solid fa-calendar-check text-primary"></i>
                    </div>
                    <div>
                        <strong>Appointment:</strong> @(appt.Patient?.FirstName) @(appt.Patient?.LastName) with Dr. @(appt.Doctor?.FirstName) @(appt.Doctor?.LastName)
                        <div class="text-muted small">@appt.AppointmentDate.ToString("MMM dd, hh:mm tt")</div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted text-center py-3">No recent activities.</p>
        }
    </div>
</div>

<!-- CHART JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // BAR CHART
    new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.ChartLabels)),
            datasets: [{
                label: 'Patients',
                data: @Html.Raw(Json.Serialize(Model.WeeklyPatients)),
                backgroundColor: '#16a34a',
                borderRadius: 8
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true } }
        }
    });

    // LINE CHART
    new Chart(document.getElementById('lineChart'), {
        type: 'line',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.ChartLabels)),
            datasets: [{
                label: 'Appointments',
                data: @Html.Raw(Json.Serialize(Model.WeeklyAppointments)),
                borderColor: '#0d6efd',
                backgroundColor: 'rgba(13, 110, 253, 0.1)',
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true } }
        }
    });
</script>