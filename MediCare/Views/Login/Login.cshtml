@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login - MediCare+</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    
    <!-- Custom CSS from React -->
    <link href="~/css/login.css" rel="stylesheet" />
</head>

<body>

    <div class="login-container">

      <!-- LEFT SIDE -->
      <div class="left-section">
        <div class="brand">
          <div class="brand-icon-box">
            <i class="fa-solid fa-heart-pulse brand-icon-svg"></i>
          </div>
          <div class="brand-text">
            <h3>MediCare</h3>
            <span>Smart OPD</span>
          </div>
        </div>

        <div class="left-content">
          <h1>Streamline Your Healthcare Operations</h1>
          <p>
            Manage appointments, patients, and OPD queues efficiently
            with our intelligent healthcare platform.
          </p>

          <div class="cta-box">
            <span>Learn more about our services</span>
            <i class="fa-solid fa-chevron-right cta-icon" style="display:flex; align-items:center;"></i>
          </div>
        </div>

        <!-- Subtle decorative circles -->
        <div class="decoration-circle circle-1"></div>
        <div class="decoration-circle circle-2"></div>
      </div>

      <!-- RIGHT SIDE -->
      <div class="right-section">

        <div class="top-logo">
          <h2 style="color: #0fb48c; font-weight: 800;">MediCare+</h2>
        </div>

        <div class="login-card">
          <h2>Welcome Back </h2>
          <p class="subtitle">Please login to your account</p>

          @if (TempData["Success"] != null)
          {
              <div style="background-color: #ecfdf5; color: #047857; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; font-weight: 500;">
                  <i class="fa-solid fa-circle-check" style="margin-right: 8px;"></i> @TempData["Success"]
              </div>
          }

          @if (ViewBag.Error != null)
          {
              <div style="background-color: #fee2e2; color: #dc2626; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; font-weight: 500;">
                  <i class="fa-solid fa-circle-exclamation" style="margin-right: 8px;"></i> @ViewBag.Error
              </div>
          }

          <form asp-controller="Login" asp-action="Login" method="post" class="login-form">

            <div class="input-group">
              <label>Email Address</label>
              <div class="input-with-icon">
                <i class="fa-regular fa-envelope input-icon"></i>
                <input type="email" name="Email" placeholder="Enter your email" required />
              </div>
            </div>

            <div class="input-group">
              <label>Password</label>
              <div class="input-with-icon">
                <i class="fa-solid fa-lock input-icon"></i>
                <input type="password" name="Password" placeholder="Enter your password" required />
              </div>
            </div>

            <div class="options">
              <label class="checkbox-container">
                <input type="checkbox" />
                <span>Remember me</span>
              </label>
              <a asp-controller="Login" asp-action="ForgotPassword" style="color: #0fb48c; text-decoration: none; font-size: 14px; font-weight: 500;">Forgot password?</a>
            </div>

            <button type="submit" class="login-btn">
              Login
            </button>

          </form>

          <div style="margin: 18px 0 16px; display:flex; align-items:center; gap:12px; color:#94a3b8; font-size:13px;">
            <div style="height:1px; background:#e2e8f0; flex:1;"></div>
            <span>Or continue with</span>
            <div style="height:1px; background:#e2e8f0; flex:1;"></div>
          </div>

          <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
            <a asp-action="ExternalLogin" asp-route-provider="Google"
               style="display:flex; align-items:center; justify-content:center; gap:10px; text-decoration:none; border:1px solid #e2e8f0; border-radius:14px; padding:14px 16px; color:#111827; font-weight:700; background:#fff;">
              <i class="fa-brands fa-google" style="color:#ea4335; font-size:18px;"></i>
              <span>Google</span>
            </a>
            <a asp-action="ExternalLogin" asp-route-provider="GitHub"
               style="display:flex; align-items:center; justify-content:center; gap:10px; text-decoration:none; border:1px solid #e2e8f0; border-radius:14px; padding:14px 16px; color:#111827; font-weight:700; background:#fff;">
              <i class="fa-brands fa-github" style="color:#111827; font-size:18px;"></i>
              <span>GitHub</span>
            </a>
          </div>

          <div class="signup-link">
            Don't have an account? <a asp-controller="Login" asp-action="Register">Sign up</a>
          </div>

        </div>

        <div class="support-footer">
          Need help? <a href="mailto:support@medicare.com">support@medicare.com</a>
        </div>

      </div>

    </div>

</body>
</html>
