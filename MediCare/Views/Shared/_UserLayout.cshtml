@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - MediCare</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        /* ===== Layout Wrapper ===== */
        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* ===== Sidebar ===== */
        .sidebar {
            width: 260px;
            background: #ffffff;
            border-right: 1px solid #f1f5f9;
            padding: 25px 20px;
            display: flex;
            flex-direction: column;
            position: sticky;
            top: 0;
            height: 100vh;
        }

        .logo {
            display: flex;
            align-items: center;
            margin-bottom: 30px;
            flex-shrink: 0;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: #10b981;
            color: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
        }

        .logo h5 {
            margin: 0;
            font-weight: 600;
        }

        .logo small {
            color: #888;
        }

        .menu {
            overflow-y: auto;
            flex-grow: 1;
            margin-bottom: 20px;
        }

        .menu a {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            border-radius: 14px;
            color: #64748b;
            text-decoration: none;
            margin-bottom: 5px;
            transition: 0.2s;
            font-weight: 500;
        }

            .menu a i {
                width: 22px;
                margin-right: 12px;
                font-size: 18px;
            }

            .menu a:hover {
                background: #f8fafc;
                color: #10b981;
            }

            .menu a.active {
                background: #ecfdf5;
                color: #059669;
                font-weight: 600;
            }

        .logout {
            margin-top: auto;
            padding: 15px;
            border-top: 1px solid #f1f5f9;
            color: #ef4444;
            text-decoration: none;
            display: flex;
            align-items: center;
            font-weight: 600;
            border-radius: 14px;
            transition: 0.2s;
            flex-shrink: 0;
        }
        .logout:hover {
            background: #fef2f2;
            color: #dc2626;
        }

        /* ===== Main Content ===== */
        .main {
            flex: 1;
            padding: 25px 35px;
        }

        /* ===== Topbar ===== */
        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .search-box {
            position: relative;
            width: 420px;
        }

            .search-box input {
                width: 100%;
                height: 42px;
                border-radius: 14px;
                border: 1px solid #e5e7eb;
                padding-left: 40px;
                background: #f9fafb;
            }

            .search-box i {
                position: absolute;
                top: 13px;
                left: 14px;
                color: #9ca3af;
            }

        .profile-area {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .profile-circle {
            width: 38px;
            height: 38px;
            background: #10b981;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        @@media (max-width: 992px) {
            .sidebar {
                display: none;
            }

            .search-box {
                width: 250px;
            }
        }
    </style>
</head>

<body>

    <div class="layout">

        <!-- Sidebar -->
        <div class="sidebar">

            <div class="logo">
                <div class="logo-icon">
                    <i class="fa-solid fa-heart-pulse"></i>
                </div>
                <div>
                    <h5>MediCare</h5>
                    <small>Patient Panel</small>
                </div>
            </div>

            <div class="text-center mb-4 pb-3 border-bottom">
                <div style="width: 55px; height: 55px; border-radius: 50%; background: #d1fae5; color: #10b981; font-size: 22px; font-weight: bold; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto 12px; border: 2px solid #10b981; text-transform: uppercase;">
                    @(Context.Session.GetString("UserName")?.Substring(0, 1) ?? "P")
                </div>
                <h6 class="mb-0 fw-bold" style="color: #333;">@(Context.Session.GetString("UserName") ?? "Patient User")</h6>
                <small class="text-muted" style="font-size: 12px;">@(Context.Session.GetString("UserEmail") ?? "patient@medicare.com")</small>
            </div>

            <div class="menu">

                <a asp-controller="User" asp-action="Dashboard"
                   class="@(currentAction == "Dashboard" ? "active" : "")">
                    <i class="fa-solid fa-house"></i> Home
                </a>

                <a asp-controller="User" asp-action="Doctors"
                   class="@(currentAction == "Doctors" ? "active" : "")">
                    <i class="fa-solid fa-user-doctor"></i> Doctors
                </a>

                <a asp-controller="User" asp-action="BookAppointment"
                   class="@(currentAction == "BookAppointment" ? "active" : "")">
                    <i class="fa-solid fa-square-plus"></i> Book Appointment
                </a>

                <a asp-controller="User" asp-action="MyAppointments"
                   class="@(currentAction == "MyAppointments" ? "active" : "")">
                    <i class="fa-solid fa-calendar-check"></i> My Appointments
                </a>

                <a asp-controller="User" asp-action="TokenStatus"
                   class="@(currentAction == "TokenStatus" ? "active" : "")">
                    <i class="fa-regular fa-clock"></i> Token Status
                </a>

                <a asp-controller="User" asp-action="Prescriptions"
                   class="@(currentAction == "Prescriptions" ? "active" : "")">
                    <i class="fa-solid fa-file-prescription"></i> Prescriptions
                </a>

                <a asp-action="Notifications" class="@(currentAction == "Notifications" ? "active" : "")">
                    <i class="fa-regular fa-bell"></i> Notifications
                </a>
                
                <a asp-controller="User" asp-action="History"
                   class="@(currentAction == "History" ? "active" : "")">
                    <i class="fa-solid fa-history"></i> History
                </a>

                <a asp-action="Feedback" class="@(currentAction == "Feedback" ? "active" : "")">
                    <i class="fa-regular fa-comment-dots"></i> Feedback
                </a>

                <a asp-controller="User" asp-action="Profile"
                   class="@(currentAction == "Profile" ? "active" : "")">
                    <i class="fa-regular fa-user"></i> Profile
                </a>

                <a asp-action="Settings" class="@(currentAction == "Settings" ? "active" : "")">
                    <i class="fa-solid fa-gear"></i> Settings
                </a>

            </div>

            <a asp-controller="Login" asp-action="Logout" class="logout">
                <i class="fa fa-sign-out-alt me-1"></i> Logout
            </a>

        </div>

        <!-- Main Content -->
        <div class="main">

            <!-- Topbar -->
            <div class="topbar border-bottom pb-3 mb-4">

                <div class="search-box">
                    <i class="fa fa-search"></i>
                    <input type="text" placeholder="Search for anything..." class="border-0 shadow-none bg-transparent" />
                </div>

                <div class="profile-area">
                    <button class="btn btn-link text-muted p-2 shadow-none"><i class="fa-regular fa-moon"></i></button>
                    <a asp-action="Notifications" class="btn btn-link text-muted p-2 shadow-none position-relative text-decoration-none">
                        <i class="fa-regular fa-bell"></i>
                        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle" style="width: 8px; height: 8px;"></span>
                    </a>
                    
                    <div style="display: flex; align-items: center; gap: 10px; border-left: 1px solid #e5e7eb; padding-left: 15px; margin-left: 5px;">
                        <a href="@Url.Action("Profile", "User")" style="text-decoration: none;">
                            <div class="profile-circle shadow-sm" style="text-transform: uppercase; background: #ecfdf5; color: #10b981; border: 1px solid #10b981;">@(Context.Session.GetString("UserName")?.Substring(0, 1) ?? "P")</div>
                        </a>
                    </div>
                </div>

            </div>

            <!-- Page Content -->
            @RenderBody()

        </div>

    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>