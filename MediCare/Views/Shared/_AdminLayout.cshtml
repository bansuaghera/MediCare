@inject MediCare.Services.NotificationService NotificationService
@inject MediCare.Services.LoginSessionService LoginSessionService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var userEmail = Context.Session.GetString("UserEmail") ?? string.Empty;
    var unreadNotificationCount = string.IsNullOrEmpty(userEmail) ? 0 : NotificationService.CountUnread(userEmail);
    var loginAtRaw = Context.Session.GetString("LoginAt") ?? string.Empty;
    var loginLabel = "Logged out";
    if (DateTime.TryParse(loginAtRaw, null, System.Globalization.DateTimeStyles.RoundtripKind, out var loginAt))
    {
        loginLabel = loginAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - MediCare</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <!-- FullCalendar -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background-color: #f4f6f9;
            overflow-x: hidden;
            font-family: 'Segoe UI', sans-serif;
        }

        /* SIDEBAR */
        .sidebar {
            width: 260px;
            height: 100vh;
            background: #ffffff;
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            border-right: 1px solid #e5e5e5;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1050;
        }

        .sidebar-header {
            padding: 25px 20px;
            background: #fff;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .sidebar-content {
            flex: 1;
            overflow-y: auto;
            padding: 10px 0;
        }

        /* Custom Scrollbar */
        .sidebar-content::-webkit-scrollbar {
            width: 5px;
        }
        .sidebar-content::-webkit-scrollbar-thumb {
            background: #e5e5e5;
            border-radius: 10px;
        }

        .logo-box {
            display: flex;
            align-items: center;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #16a34a, #14b8a6);
            color: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            font-size: 18px;
            box-shadow: 0 4px 12px rgba(22, 163, 74, 0.2);
        }

        .brand-title {
            font-weight: 700;
            font-size: 19px;
            color: #1a1a1a;
            letter-spacing: -0.5px;
        }

        .brand-sub {
            font-size: 12px;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .session-time {
            font-size: 11px;
            color: #64748b;
            margin-top: 10px;
            line-height: 1.45;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 8px 10px;
        }

        .nav-link {
            color: #4b5563;
            padding: 12px 20px;
            margin: 4px 15px;
            border-radius: 10px;
            font-weight: 500;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            text-decoration: none;
        }

            .nav-link i {
                width: 24px;
                font-size: 18px;
                margin-right: 12px;
                transition: transform 0.2s;
            }

            .nav-link:hover {
                background: #f3f4f6;
                color: #16a34a;
            }

            .nav-link:hover i {
                transform: translateX(3px);
            }

            .nav-link.active {
                background: #ecfdf5;
                color: #059669 !important;
                font-weight: 600;
                box-shadow: inset 0 0 0 1px rgba(16, 185, 129, 0.1);
            }

        /* CONTENT */
        .content {
            margin-left: 260px;
            padding: 40px;
            min-height: 100vh;
            transition: all 0.3s;
        }

        .content-toolbar {
            margin-bottom: 18px;
        }

        .content-search {
            width: min(520px, 100%);
            display: flex;
            align-items: center;
            gap: 10px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 12px 16px;
            color: #94a3b8;
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
        }

        .content-search input {
            border: 0;
            outline: none;
            background: transparent;
            width: 100%;
            font-size: 14px;
            color: #111827;
        }

        /* MOBILE TOPBAR */
        .mobile-topbar {
            display: none;
            background: white;
            padding: 12px 20px;
            border-bottom: 1px solid #e5e5e5;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1001;
        }

        .sidebar-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(4px);
            z-index: 1040;
        }

        /* RESPONSIVE FIX */
        @@media (max-width: 992px) {
            .sidebar {
                left: -260px;
                box-shadow: none;
            }

            .sidebar.show {
                left: 0;
                box-shadow: 20px 0 50px rgba(0,0,0,0.1);
            }

            .sidebar.show + .sidebar-backdrop {
                display: block;
            }

            .content {
                margin-left: 0;
                padding: 24px;
            }

            .mobile-topbar {
                display: flex;
            }
        }
    </style>
</head>

<body>

    <!-- MOBILE TOPBAR -->
    <div class="mobile-topbar">
        <button class="btn btn-light shadow-sm border" id="menuToggle">
            <i class="fa fa-bars"></i>
        </button>
        <span class="ms-3 fw-bold">Welcome, @(Context.Session.GetString("UserName") ?? "Admin")</span>
    </div>

    <!-- SIDEBAR -->
    <div class="sidebar" id="sidebar">

        <div class="sidebar-header">
            <div class="logo-box">
                <div class="logo-icon">
                    <i class="fa-solid fa-heart-pulse"></i>
                </div>
                <div>
                    <div class="brand-title">MediCare</div>
                    <div class="brand-sub">@(Context.Session.GetString("UserRole") ?? "Admin") Panel</div>
                </div>
            </div>
            
            <div class="mt-4 pt-3 border-top text-center pb-2">
                <div class="mb-2">
                    <a asp-controller="Admin" asp-action="Profile" class="text-decoration-none">
                        <div style="width: 50px; height: 50px; border-radius: 50%; background: #ecfdf5; border: 2px solid #16a34a; display: inline-flex; align-items: center; justify-content: center; font-size: 22px; color: #16a34a; font-weight: bold; text-transform: uppercase;">
                            @(Context.Session.GetString("UserName")?.Substring(0, 1) ?? "A")
                        </div>
                    </a>
                </div>
                <h6 class="mb-0 fw-bold text-dark">@(Context.Session.GetString("UserName") ?? "Admin User")</h6>
                <small class="text-muted">@(Context.Session.GetString("UserEmail") ?? "admin@medicare.com")</small>
                <div class="session-time mt-2">
                    <div><i class="fa-regular fa-clock me-1"></i> Login: <span id="loginTimeText">@loginLabel</span></div>
                    <div><i class="fa-solid fa-hourglass-half me-1"></i> Live: <span id="sessionLiveText">--:--:--</span></div>
                </div>
            </div>
        </div>

        <div class="sidebar-content">
            <nav class="nav flex-column">

                <a class="nav-link @(currentController == "Admin" && currentAction == "Dashboard" ? "active" : "")"
                   asp-controller="Admin" asp-action="Dashboard">
                    <i class="fa-solid fa-chart-line"></i> Dashboard
                </a>

                <a class="nav-link @(currentController == "Admin" && currentAction == "Patient" ? "active" : "")"
                   asp-controller="Admin" asp-action="Patient">
                    <i class="fa-regular fa-user"></i> Patients
                </a>

                <a class="nav-link @(currentController == "Admin" && currentAction == "Doctors" ? "active" : "")"
                   asp-controller="Admin" asp-action="Doctors">
                    <i class="fa-solid fa-user-doctor"></i> Doctors
                </a>

                <a class="nav-link @(currentController == "Admin" && currentAction == "Staff" ? "active" : "")"
                   asp-controller="Admin" asp-action="Staff">
                    <i class="fa-solid fa-users"></i> Staff
                </a>


                <a class="nav-link @(currentController == "Admin" && currentAction == "Appointments" ? "active" : "")"
                   asp-controller="Admin" asp-action="Appointments">
                    <i class="fa-solid fa-calendar-check"></i> Appointments
                </a>

                <a class="nav-link @(currentController == "Admin" && currentAction == "TokenQueue" ? "active" : "")"
                   asp-controller="Admin" asp-action="TokenQueue">
                    <i class="fa-solid fa-list"></i> Token Queue
                </a>

                <a class="nav-link @(currentController == "Admin" && currentAction == "Prescriptions" ? "active" : "")"
                   asp-controller="Admin" asp-action="Prescriptions">
                    <i class="fa-solid fa-book-medical"></i> Prescriptions
                </a>
                <a class="nav-link @(currentController == "Admin" && currentAction == "Medicines" ? "active" : "")"
                   asp-controller="Admin" asp-action="Medicines">
                    <i class="fa-solid fa-pills"></i> Medicines
                </a>

                <a class="nav-link @(currentController == "Admin" && currentAction == "PendingApprovals" ? "active" : "")"
                   asp-controller="Admin" asp-action="PendingApprovals">
                    <i class="fa-solid fa-user-clock"></i> Pending Approvals
                </a>

                <a class="nav-link @(currentController == "Admin" && currentAction == "ManageUsers" ? "active" : "")"
                   asp-controller="Admin" asp-action="ManageUsers">
                    <i class="fa-solid fa-user-gear"></i> Manage Users
                </a>

                <a class="nav-link @(currentController == "Admin" && currentAction == "Templates" ? "active" : "")"
                   asp-controller="Admin" asp-action="Templates">
                    <i class="fa-regular fa-file-lines"></i> Templates
                </a>

                <a class="nav-link @(currentController == "Admin" && currentAction == "Profile" ? "active" : "")"
                   asp-controller="Admin" asp-action="Profile">
                    <i class="fa-solid fa-user-tie"></i> Profile
                </a>

                <a class="nav-link @(currentController == "Admin" && currentAction == "Analytics" ? "active" : "")"
                   asp-controller="Admin" asp-action="Analytics">
                    <i class="fa-solid fa-chart-pie"></i> Analytics
                </a>

                <a class="nav-link @(currentController == "Admin" && currentAction == "History" ? "active" : "")"
                   asp-controller="Admin" asp-action="History">
                    <i class="fa-solid fa-clock-rotate-left"></i> History
                </a>

                <a class="nav-link @(currentController == "Admin" && currentAction == "Notifications" ? "active" : "")"
                   asp-controller="Admin" asp-action="Notifications">
                    <i class="fa-regular fa-bell"></i> Notifications
                    @if (unreadNotificationCount > 0)
                    {
                        <span class="ms-auto rounded-circle bg-danger d-inline-block" style="width:8px;height:8px;"></span>
                    }
                </a>

                <a class="nav-link @(currentController == "Admin" && currentAction == "Feedbacks" ? "active" : "")"
                   asp-controller="Admin" asp-action="Feedbacks">
                    <i class="fa-regular fa-comment-dots"></i> Feedback Management
                </a>


            </nav>
        </div>

        <div class="logout-footer p-3 border-top bg-light">
            <a class="nav-link text-danger m-0" asp-controller="Login" asp-action="Logout" style="border-radius: 10px; font-weight: 700; color: #dc2626 !important;">
                <i class="fa-solid fa-sign-out-alt"></i> Logout System
            </a>
        </div>

    </div>

    <!-- BACKDROP FOR MOBILE -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- CONTENT -->
    <div class="content">
        <div class="content-toolbar">
            <div class="content-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="pageSearchInput" placeholder="Search patients, doctors, appointments..." />
            </div>
        </div>
        @RenderBody()
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    @RenderSection("Scripts", required: false)

    <script>
        const toggleBtn = document.getElementById("menuToggle");
        const backdrop = document.getElementById("sidebarBackdrop");
        const sidebar = document.getElementById("sidebar");

        function toggleSidebar() {
            sidebar.classList.toggle("show");
        }

        toggleBtn?.addEventListener("click", toggleSidebar);
        backdrop?.addEventListener("click", toggleSidebar);
    </script>
    <script>
        (function () {
            const raw = '@loginAtRaw';
            if (!raw) return;
            const start = new Date(raw);
            if (isNaN(start.getTime())) return;
            const tick = () => {
                const diff = Math.max(0, Date.now() - start.getTime());
                const sec = Math.floor(diff / 1000);
                const h = String(Math.floor(sec / 3600)).padStart(2, '0');
                const m = String(Math.floor((sec % 3600) / 60)).padStart(2, '0');
                const s = String(sec % 60).padStart(2, '0');
                const el = document.getElementById('sessionLiveText');
                if (el) el.textContent = `${h}:${m}:${s}`;
            };
            tick();
            setInterval(tick, 1000);
        })();

        (function () {
            const input = document.getElementById('pageSearchInput');
            if (!input) return;
            const root = document.querySelector('.content') || document.body;
            const selectors = [
                'tbody tr',
                '.appointment-card',
                '.queue-item',
                '.row-card',
                '.card-box',
                '.notification-item',
                '.notification-card',
                '.feedback-card',
                '.history-item',
                '.patient-card',
                '.doctor-card',
                '.prescription-card',
                '.list-group-item',
                '.searchable-item'
            ];
            const filter = () => {
                const term = input.value.trim().toLowerCase();
                const items = Array.from(root.querySelectorAll(selectors.join(',')));
                const seen = new Set();
                items.forEach(item => {
                    if (seen.has(item)) return;
                    seen.add(item);
                    const text = (item.dataset.search || item.innerText || '').toLowerCase();
                    item.style.display = !term || text.includes(term) ? '' : 'none';
                });
            };
            input.addEventListener('input', filter);
        })();
    </script>
    @if(TempData["ToastMessage"] != null){
        <div class="toast align-items-center text-bg-@(TempData["ToastType"] ?? "success") position-fixed top-0 end-0 m-3 show" role="alert" aria-live="assertive" aria-atomic="true" style="z-index:2000;">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["ToastMessage"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    }

</body>
</html>
