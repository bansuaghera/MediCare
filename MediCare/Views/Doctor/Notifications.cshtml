@model IEnumerable<MediCare.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-0">My Notifications</h4>
        <div class="text-muted">Latest activities for you and your patients</div>
    </div>
    @if (Model.Any())
    {
        <div class="d-flex gap-2 align-items-center">
            <button class="btn btn-outline-secondary btn-sm" id="selectAllBtn">Select All</button>
            <button class="btn btn-outline-danger btn-sm" id="deleteSelectedBtn" disabled>Delete Selected</button>
            <button class="btn btn-danger btn-sm" onclick="deleteAll()">Delete All</button>
            <button class="btn btn-success btn-sm" onclick="markAll()">Mark All Read</button>
        </div>
    }
</div>

@if (Model.Any())
{
    <div class="list-group">
        @foreach (var n in Model)
        {
            var cls = n.Type == "success" ? "text-success" : n.Type == "warning" ? "text-warning" : n.Type == "error" ? "text-danger" : "text-primary";
            <div class="list-group-item border-0 mb-2 p-3 rounded-3 shadow-sm bg-white">
                <div class="d-flex align-items-start gap-3">
                    <input type="checkbox" class="form-check-input shadow-none mt-1 row-check" data-id="@n.Id" />
                    <div>
                        <div class="fw-bold @cls">@n.Title</div>
                        <div class="text-muted small">@n.Message</div>
                        <div class="text-muted small">@n.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">No notifications yet.</div>
}

@section Scripts {
    <script>
        const checks=()=>Array.from(document.querySelectorAll('.row-check'));
        const delSel=document.getElementById('deleteSelectedBtn');
        const selAll=document.getElementById('selectAllBtn');
        function sync(){
            const any=checks().some(c=>c.checked);
            if(delSel) delSel.disabled=!any;
            if(selAll){
                const all=checks().every(c=>c.checked);
                selAll.textContent=all?'Clear All':'Select All';
            }
        }
        checks().forEach(c=>c.addEventListener('change',sync));
        if(selAll) selAll.onclick=()=>{const all=checks().every(c=>c.checked);checks().forEach(c=>c.checked=!all);sync();};
        if(delSel) delSel.onclick=()=>{const ids=checks().filter(c=>c.checked).map(c=>parseInt(c.dataset.id));if(ids.length===0)return;if(!confirm(`Delete ${ids.length} notifications?`))return;$.ajax({url:'/Doctor/DeleteNotifications',type:'POST',contentType:'application/json',data:JSON.stringify(ids),success:r=>location.reload()});};
        function deleteAll(){if(!confirm('Delete ALL notifications?'))return;$.post('/Doctor/DeleteAllNotifications',r=>location.reload());}
        function markAll(){ $.post('/Doctor/MarkAllNotificationsRead',r=>location.reload()); }
        sync();
    </script>
}
