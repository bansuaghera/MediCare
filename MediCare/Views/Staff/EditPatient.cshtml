@model MediCare.Models.Patient
@{
    ViewData["Title"] = "Edit Patient";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 25px;
    }

    .form-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .form-control, .form-select {
        border-radius: 10px;
        padding: 10px 12px;
    }

    .btn-register {
        background: #16a34a;
        border: none;
        padding: 10px 20px;
        border-radius: 10px;
    }

        .btn-register:hover {
            background: #15803d;
        }

    .btn-cancel {
        border-radius: 10px;
        padding: 10px 20px;
    }
</style>

<div class="page-header">
    <h3 class="fw-bold">Edit Patient</h3>
    <p class="text-muted">Update patient information</p>
</div>

<div class="form-card">

    <form asp-action="EditPatient" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="row g-4">

            <!-- First Name -->
            <div class="col-md-4">
                <label class="form-label">First Name *</label>
                <input type="text" asp-for="FirstName" class="form-control" placeholder="Enter first name" required />
            </div>

            <!-- Last Name -->
            <div class="col-md-4">
                <label class="form-label">Last Name *</label>
                <input type="text" asp-for="LastName" class="form-control" placeholder="Enter last name" required />
            </div>

            <!-- Date of Birth -->
            <div class="col-md-4">
                <label class="form-label">Date of Birth *</label>
                <input type="date" asp-for="DateOfBirth" class="form-control" required />
            </div>

            <!-- Gender -->
            <div class="col-md-4">
                <label class="form-label">Gender *</label>
                <select asp-for="Gender" class="form-select" required>
                    <option value="" selected disabled>Select gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <!-- Blood Group -->
            <div class="col-md-4">
                <label class="form-label">Blood Group</label>
                <select asp-for="BloodGroup" class="form-select">
                    <option value="" selected>Select</option>
                    <option value="O+">O+</option>
                    <option value="O-">O-</option>
                    <option value="A+">A+</option>
                    <option value="A-">A-</option>
                    <option value="B+">B+</option>
                    <option value="B-">B-</option>
                    <option value="AB+">AB+</option>
                    <option value="AB-">AB-</option>
                </select>
            </div>

            <!-- Phone -->
            <div class="col-md-4">
                <label class="form-label">Phone Number *</label>
                <input type="tel" asp-for="Phone" class="form-control" placeholder="+91 98765 43210" required />
            </div>

            <!-- Email -->
            <div class="col-md-4">
                <label class="form-label">Email</label>
                <input type="email" asp-for="Email" class="form-control" placeholder="patient@example.com" />
            </div>
            
            <!-- Address -->
            <div class="col-md-12">
                <label class="form-label">Address</label>
                <textarea asp-for="Address" class="form-control" rows="2" placeholder="Enter full address"></textarea>
            </div>
            
            <!-- Medical History -->
            <div class="col-md-12">
                <label class="form-label">Medical History</label>
                <textarea asp-for="MedicalHistory" class="form-control" rows="3" placeholder="Any allergies, previous conditions, etc."></textarea>
            </div>

        </div>

        <!-- Buttons -->
        <div class="mt-4">

            <button type="submit" class="btn btn-register text-white me-2">
                <i class="fa fa-save me-2"></i> Save Changes
            </button>

            <a asp-action="Patients" class="btn btn-outline-secondary btn-cancel">
                Cancel
            </a>

        </div>

    </form>

</div>
