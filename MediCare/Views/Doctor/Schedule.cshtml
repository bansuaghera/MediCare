@{
    ViewData["Title"] = "My Schedule";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    body {
        background: #f4f6f9;
    }

    /* ===== Topbar ===== */
    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .search-wrapper {
        position: relative;
        width: 420px;
    }

        .search-wrapper input {
            width: 100%;
            height: 45px;
            border-radius: 14px;
            border: 1px solid #e5e7eb;
            padding-left: 40px;
            background: #f9fafb;
        }

        .search-wrapper i {
            position: absolute;
            top: 14px;
            left: 14px;
            color: #9ca3af;
        }

    .profile-area {
        display: flex;
        align-items: center;
        gap: 20px;
    }

        .profile-area i {
            font-size: 18px;
            color: #6b7280;
            cursor: pointer;
        }

    .profile-circle {
        width: 40px;
        height: 40px;
        background: #10b981;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }

    /* ===== Page Header ===== */
    .page-title {
        font-size: 26px;
        font-weight: 700;
    }

    .page-subtitle {
        color: #6b7280;
        margin-bottom: 30px;
    }

    /* ===== Cards ===== */
    .card-custom {
        background: #ffffff;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 10px;
        text-align: center;
        font-size: 14px;
    }

        .calendar-grid div {
            padding: 8px;
            border-radius: 10px;
            cursor: pointer;
            color: #6b7280;
        }

        .calendar-grid .selected {
            background: #10b981;
            color: white;
            font-weight: 600;
        }

    /* ===== Session Cards ===== */
    .session-card {
        border-radius: 20px;
        padding: 22px;
        margin-bottom: 20px;
        position: relative;
    }

    .morning-card {
        background: #d1fae5;
    }

    .afternoon-card {
        background: #dbeafe;
    }

    .session-icon {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        font-size: 18px;
    }

    .session-time {
        font-size: 14px;
        margin-top: 6px;
    }

    .session-count {
        font-size: 14px;
        margin-top: 8px;
        font-weight: 500;
    }
</style>

<!-- ===== Topbar ===== -->
<div class="topbar">

    <div class="search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" placeholder="Search patients, appointments..." />
    </div>

    <div class="profile-area">
        <i class="fa fa-bell"></i>
        <div class="profile-circle">
            ST
        </div>
    </div>

</div>

<!-- ===== Page Header ===== -->
<div class="page-title">My Schedule</div>
<div class="page-subtitle">View your OPD schedule</div>

<div class="row">

    <!-- Calendar Section -->
    <div class="col-md-5">
        <div class="card-custom">

            <h6 class="fw-bold mb-3">Select Date</h6>

            <div class="calendar-header">
                <i class="fa fa-chevron-left"></i>
                <span>February 2026</span>
                <i class="fa fa-chevron-right"></i>
            </div>

            <div class="calendar-grid">
                <div>Su</div><div>Mo</div><div>Tu</div>
                <div>We</div><div>Th</div><div>Fr</div><div>Sa</div>

                <div>1</div><div>2</div><div>3</div>
                <div>4</div><div>5</div><div>6</div><div>7</div>

                <div>8</div><div>9</div><div>10</div>
                <div>11</div><div>12</div>
                <div class="selected">13</div>
                <div>14</div>

                <div>15</div><div>16</div><div>17</div>
                <div>18</div><div>19</div><div>20</div><div>21</div>

                <div>22</div><div>23</div><div>24</div>
                <div>25</div><div>26</div><div>27</div><div>28</div>
            </div>

        </div>
    </div>

    <!-- Schedule Section -->
    <div class="col-md-7">

        <h6 class="fw-bold mb-3">Today's Schedule</h6>

        <!-- Morning Session -->
        <div class="session-card morning-card">

            <div class="session-icon">
                <i class="fa fa-sun text-warning"></i>
            </div>

            <h6 class="fw-bold">Morning Session</h6>

            <div class="session-time">
                <i class="fa fa-clock me-1"></i>
                09:00 AM – 12:00 PM • Room 101
            </div>

            <div class="session-count">
                <i class="fa fa-users me-1"></i>
                12 appointments scheduled
            </div>

        </div>

        <!-- Afternoon Session -->
        <div class="session-card afternoon-card">

            <div class="session-icon">
                <i class="fa fa-moon text-primary"></i>
            </div>

            <h6 class="fw-bold text-primary">Afternoon Session</h6>

            <div class="session-time text-primary">
                <i class="fa fa-clock me-1"></i>
                02:00 PM – 05:00 PM • Room 101
            </div>

            <div class="session-count text-primary">
                <i class="fa fa-users me-1"></i>
                8 appointments scheduled
            </div>

        </div>

    </div>

</div>