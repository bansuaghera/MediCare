@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - MediCare Doctor</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary: #10b981;
            --primary-soft: #ecfdf5;
            --text-dark: #111827;
            --text-muted: #6b7280;
            --sidebar-width: 280px;
            --bg-body: #f9fafb;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-body);
            margin: 0;
            display: flex;
            min-height: 100vh;
            color: var(--text-dark);
        }

        /* SIDEBAR */
        .sidebar {
            width: var(--sidebar-width);
            background: #ffffff;
            border-right: 1px solid #f1f5f9;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            position: sticky;
            top: 0;
            height: 100vh;
            z-index: 100;
        }

        .sidebar-header {
            padding: 30px 24px;
        }

        .logo-box {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 40px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: var(--primary);
            color: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .profile-card {
            background-color: #f8fafc;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 30px;
            border: 1px solid #f1f5f9;
        }

        .profile-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: #d1fae5;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 18px;
            margin-bottom: 12px;
        }

        .profile-name {
            font-weight: 700;
            font-size: 14px;
            margin: 0;
            text-transform: uppercase;
        }

        .profile-email {
            font-size: 11px;
            color: var(--text-muted);
            word-break: break-all;
            margin-bottom: 8px;
        }

        .role-badge {
            background: var(--primary);
            color: white;
            padding: 2px 10px;
            border-radius: 6px;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            display: inline-block;
        }

        .sidebar-menu {
            flex-grow: 1;
            padding: 0 16px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 transparent;
        }
        .sidebar-menu::-webkit-scrollbar {
            width: 6px;
        }
        .sidebar-menu::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        .sidebar-menu::-webkit-scrollbar-track {
            background: transparent;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            border-radius: 12px;
            color: #4b5563;
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
            margin-bottom: 4px;
            transition: 0.2s;
        }

        .nav-link i {
            width: 24px;
            font-size: 18px;
            margin-right: 12px;
            color: #94a3b8;
        }

        .nav-link:hover {
            background-color: #f8fafc;
            color: var(--primary);
        }

        .nav-link:hover i {
            color: var(--primary);
        }

        .nav-link.active {
            background-color: var(--primary-soft);
            color: var(--primary);
            font-weight: 600;
        }

        .nav-link.active i {
            color: var(--primary);
        }

        .sidebar-footer {
            padding: 16px;
            border-top: 1px solid #f1f5f9;
        }

        .logout-link {
            color: #ef4444;
            display: flex;
            align-items: center;
            padding: 12px 16px;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
        }

        /* MAIN CONTENT AREA */
        .wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .topbar {
            height: 80px;
            background: #ffffff;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .top-search {
            width: 450px;
            position: relative;
        }

        .top-search input {
            width: 100%;
            height: 44px;
            border-radius: 12px;
            background: #f8fafc;
            border: 1px solid #f1f5f9;
            padding-left: 45px;
            font-size: 14px;
            outline: none;
        }

        .top-search i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .notif-bell {
            font-size: 20px;
            color: #94a3b8;
            cursor: pointer;
            position: relative;
        }

        .notif-dot {
            position: absolute;
            top: 0;
            right: 0;
            width: 6px;
            height: 6px;
            background: #ef4444;
            border-radius: 50%;
        }

        .user-dd {
            width: 40px;
            height: 40px;
            background: #d1fae5;
            color: var(--primary);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            cursor: pointer;
            font-size: 14px;
        }

        .main-body {
            flex-grow: 1;
            padding: 40px;
            background-color: #f9fafb; /* Light gray body so white cards pop */
            overflow-y: auto;
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo-box">
                <div class="logo-icon">
                    <i class="fa-solid fa-heart-pulse"></i>
                </div>
                <div>
                    <h5 class="m-0 fw-bold" style="font-size: 18px; color: #111827;">MediCare</h5>
                    <small class="text-muted" style="font-size: 11px; font-weight: 600;">Doctor Panel</small>
                </div>
            </div>

            <div class="profile-card">
                <div class="profile-avatar shadow-sm">
                    @(Context.Session.GetString("UserName")?.Substring(0, 1) ?? "D")
                </div>
                <h6 class="profile-name">@(Context.Session.GetString("UserName") ?? "Dhiraj Dabhii")</h6>
                <div class="profile-email">@(Context.Session.GetString("UserEmail") ?? "dabhidhiraj75@gmail.com")</div>
                <div class="role-badge">DOCTOR</div>
            </div>
        </div>

        <div class="sidebar-menu">
            <a class="nav-link @(currentAction == "Dashboard" ? "active" : "")" asp-controller="Doctor" asp-action="Dashboard">
                <i class="fa-solid fa-table-cells-large"></i> Dashboard
            </a>
            <a class="nav-link @(currentAction == "TokenQueue" ? "active" : "")" href="/Doctor/TokenQueue">
                <i class="fa-regular fa-clock"></i> Token Queue
            </a>
            <a class="nav-link @(currentAction == "Appointments" ? "active" : "")" asp-controller="Doctor" asp-action="Appointments">
                <i class="fa-regular fa-calendar-check"></i> Appointments
            </a>
            <a class="nav-link @(currentAction == "Patients" ? "active" : "")" asp-controller="Doctor" asp-action="Patients">
                <i class="fa-regular fa-user"></i> Patients
            </a>
            <a class="nav-link @(currentAction == "Examination" ? "active" : "")" href="/Doctor/Examination">
                <i class="fa-solid fa-stethoscope"></i> Examination
            </a>
            <a class="nav-link @(currentAction == "Prescriptions" ? "active" : "")" href="/Doctor/Prescriptions">
                <i class="fa-solid fa-file-prescription"></i> Prescriptions
            </a>
            <a class="nav-link" href="/Doctor/Notifications">
                <i class="fa-regular fa-bell"></i> Notifications
            </a>
            <a class="nav-link @(currentAction == "Schedule" ? "active" : "")" href="/Doctor/Schedule">
                <i class="fa-regular fa-calendar-days"></i> Schedule
            </a>
            <a class="nav-link @(currentAction == "FollowUps" ? "active" : "")" href="/Doctor/FollowUps">
                <i class="fa-regular fa-circle-check"></i> Follow-ups
            </a>
            <a class="nav-link @(currentAction == "Feedback" ? "active" : "")" href="/Doctor/Feedback">
                <i class="fa-regular fa-comment-dots"></i> Feedback
            </a>
            <a class="nav-link @(currentAction == "Settings" ? "active" : "")" href="/Doctor/Settings">
                <i class="fa-solid fa-gear"></i> Settings
            </a>
        </div>

        <div class="sidebar-footer">
            <a class="logout-link" asp-controller="Login" asp-action="Logout">
                <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Logout
            </a>
        </div>
    </aside>

    <div class="wrapper">
        <header class="topbar">
            <div class="top-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search patients, appointments..." />
            </div>

            <div class="topbar-right">
                <div class="notif-bell">
                    <i class="fa-regular fa-bell"></i>
                    <div class="notif-dot"></div>
                </div>
                <div class="user-dd">@(Context.Session.GetString("UserName")?.Substring(0, 2).ToUpper() ?? "DD")</div>
            </div>
        </header>

        <main class="main-body">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
