@{
    ViewData["Title"] = "Analytics";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Analytics</h2>
        <p class="text-muted mb-0">Your appointment activity and visit history</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm rounded-4 p-3"><small class="text-muted">Total</small><h3 class="fw-bold mb-0">@ViewBag.TotalAppointments</h3></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm rounded-4 p-3"><small class="text-muted">Upcoming</small><h3 class="fw-bold mb-0">@ViewBag.UpcomingAppointments</h3></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm rounded-4 p-3"><small class="text-muted">Past</small><h3 class="fw-bold mb-0">@ViewBag.PastAppointments</h3></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm rounded-4 p-3"><small class="text-muted">Status Types</small><h3 class="fw-bold mb-0">4</h3></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold mb-3">Visit Trend</h5>
            <canvas id="userAnalyticsTrend" height="120"></canvas>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold mb-3">Appointment Status</h5>
            <canvas id="userAnalyticsStatus" height="240"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    new Chart(document.getElementById('userAnalyticsTrend'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(ViewBag.ChartLabels ?? new List<string>())),
            datasets: [{
                label: 'Appointments',
                data: @Html.Raw(Json.Serialize(ViewBag.ChartData ?? new List<int>())),
                backgroundColor: '#10b981',
                borderRadius: 10
            }]
        },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
    });

    new Chart(document.getElementById('userAnalyticsStatus'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(Json.Serialize(ViewBag.StatusLabels ?? new List<string>())),
            datasets: [{
                data: @Html.Raw(Json.Serialize(ViewBag.StatusData ?? new List<int>())),
                backgroundColor: ['#f59e0b', '#3b82f6', '#10b981', '#ef4444']
            }]
        },
        options: { plugins: { legend: { position: 'bottom' } } }
    });
</script>
