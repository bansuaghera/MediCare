@{
    ViewData["Title"] = "Medicine Master";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

        .page-header h2 {
            font-weight: 700;
        }

    /* GREEN ADD BUTTON */
    .add-btn {
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: #fff !important;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 600;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        box-shadow: 0 6px 18px rgba(34,197,94,0.35);
        transition: all 0.3s ease;
    }

        .add-btn:hover {
            background: linear-gradient(135deg, #16a34a, #15803d);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(34,197,94,0.45);
        }

    .card-box {
        background: white;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        overflow-x: auto;
    }

    .search-box {
        width: 100%;
        max-width: 400px;
        padding: 10px 15px;
        border-radius: 10px;
        border: 1px solid #e5e5e5;
        margin-bottom: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px;
    }

    thead {
        background: #f9fafb;
    }

    table th {
        padding: 14px 10px;
        font-size: 13px;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: left;
    }

    table td {
        padding: 14px 10px;
        border-top: 1px solid #f1f1f1;
        font-weight: 500;
    }

    .actions i {
        margin-right: 12px;
        cursor: pointer;
        color: #374151;
        transition: 0.2s;
    }

        .actions i:hover {
            color: #16a34a;
        }

        .actions i.fa-trash:hover {
            color: red;
        }

    .pagination-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        color: #6b7280;
        flex-wrap: wrap;
    }

        .pagination-box button {
            padding: 6px 14px;
            border-radius: 8px;
            border: 1px solid #ddd;
            background: white;
            margin-left: 8px;
            transition: 0.2s;
        }

            .pagination-box button:hover {
                background: #f3f4f6;
            }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .add-btn {
            width: 100%;
            justify-content: center;
        }

        table {
            font-size: 13px;
        }
    }
</style>

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h2>Medicine Master</h2>
        <p class="text-muted mb-0">Manage medicine inventory</p>
    </div>

    <a asp-controller="Admin"
       asp-action="AddMedicine"
       class="add-btn">
        <i class="fa-solid fa-plus"></i> Add Medicine
    </a>
</div>

<!-- TABLE CARD -->
<div class="card-box">

    <input type="text" class="search-box" placeholder="Search medicines..." />

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Medicine Name</th>
                <th>Category</th>
                <th>Stock</th>
                <th>Price</th>
                <th>Supplier</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td>1</td>
                <td>Amlodipine 5mg</td>
                <td>Cardiovascular</td>
                <td>500</td>
                <td>₹2.50</td>
                <td>PharmaCorp</td>
                <td class="actions">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <i class="fa-solid fa-trash"></i>
                </td>
            </tr>

            <tr>
                <td>2</td>
                <td>Metformin 500mg</td>
                <td>Diabetes</td>
                <td>750</td>
                <td>₹1.80</td>
                <td>MediSupply</td>
                <td class="actions">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <i class="fa-solid fa-trash"></i>
                </td>
            </tr>

            <tr>
                <td>3</td>
                <td>Amoxicillin 500mg</td>
                <td>Antibiotic</td>
                <td>300</td>
                <td>₹3.20</td>
                <td>PharmaCorp</td>
                <td class="actions">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <i class="fa-solid fa-trash"></i>
                </td>
            </tr>

            <tr>
                <td>4</td>
                <td>Ibuprofen 400mg</td>
                <td>Pain Relief</td>
                <td>1000</td>
                <td>₹0.90</td>
                <td>HealthDist</td>
                <td class="actions">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <i class="fa-solid fa-trash"></i>
                </td>
            </tr>

            <tr>
                <td>5</td>
                <td>Omeprazole 20mg</td>
                <td>Gastro</td>
                <td>400</td>
                <td>₹2.10</td>
                <td>MediSupply</td>
                <td class="actions">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <i class="fa-solid fa-trash"></i>
                </td>
            </tr>
        </tbody>
    </table>

    <div class="pagination-box">
        <div>Showing 5 results</div>
        <div>
            <button>Previous</button>
            <button>Next</button>
        </div>
    </div>

</div>