@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - MediCare</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background-color: #f4f6f9;
            overflow-x: hidden;
            font-family: 'Segoe UI', sans-serif;
        }

        /* SIDEBAR */
        .sidebar {
            width: 260px;
            height: 100vh;
            background: #ffffff;
            position: fixed;
            top: 0;
            left: 0;
            padding-top: 20px;
            border-right: 1px solid #e5e5e5;
            transition: 0.3s ease;
            z-index: 1000;
        }

        .logo-box {
            display: flex;
            align-items: center;
            padding: 0 20px 20px 20px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: #22c55e;
            color: white;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
        }

        .brand-title {
            font-weight: 600;
            font-size: 18px;
        }

        .brand-sub {
            font-size: 13px;
            color: gray;
        }

        .nav-link {
            color: #555;
            padding: 12px 20px;
            margin: 5px 10px;
            border-radius: 8px;
            font-weight: 500;
            transition: 0.2s;
        }

            .nav-link:hover {
                background: #e8f7ed;
                color: #16a34a;
            }

            .nav-link.active {
                background: #d1fae5;
                color: #16a34a !important;
                font-weight: 600;
            }

        /* CONTENT */
        .content {
            margin-left: 260px;
            padding: 30px;
            transition: 0.3s ease;
        }

        /* MOBILE */
        .mobile-topbar {
            display: none;
            background: white;
            padding: 10px 15px;
            border-bottom: 1px solid #e5e5e5;
            align-items: center;
            justify-content: space-between;
        }

        @@media (max-width: 992px) {
            .sidebar {
                left: -260px;
            }

                .sidebar.show {
                    left: 0;
                }

            .content {
                margin-left: 0;
                padding: 20px;
            }

            .mobile-topbar {
                display: flex;
            }
        }
    </style>
</head>

<body>

    <!-- MOBILE TOPBAR -->
    <div class="mobile-topbar">
        <button class="btn btn-light" id="menuToggle">
            <i class="fa fa-bars"></i>
        </button>
        <strong>MediCare Doctor</strong>
    </div>

    <!-- SIDEBAR -->
    <div class="sidebar" id="sidebar">

        <div class="logo-box">
            <div class="logo-icon">
                <i class="fa-solid fa-heart-pulse"></i>
            </div>
            <div>
                <div class="brand-title">MediCare</div>
                <div class="brand-sub">Doctor Panel</div>
            </div>
        </div>

        <nav class="nav flex-column">

            <a class="nav-link @(currentAction == "Dashboard" ? "active" : "")"
               asp-controller="Doctor" asp-action="Dashboard">
                <i class="fa-solid fa-chart-line"></i> Dashboard
            </a>

            <a class="nav-link @(currentAction == "Appointments" ? "active" : "")"
               asp-controller="Doctor" asp-action="Appointments">
                <i class="fa-solid fa-calendar-check"></i> Appointments
            </a>

            <a class="nav-link @(currentAction == "Patients" ? "active" : "")"
               asp-controller="Doctor" asp-action="Patients">
                <i class="fa-regular fa-user"></i> Patients
            </a>

            <a class="nav-link @(currentAction == "Examination" ? "active" : "")"
               asp-controller="Doctor" asp-action="Examination">
                <i class="fa-solid fa-stethoscope"></i> Examination
            </a>

            <a class="nav-link @(currentAction == "Prescriptions" ? "active" : "")"
               asp-controller="Doctor" asp-action="Prescriptions">
                <i class="fa-solid fa-book-medical"></i> Prescriptions
            </a>

            <a class="nav-link @(currentAction == "Schedule" ? "active" : "")"
               asp-controller="Doctor" asp-action="Schedule">
                <i class="fa-regular fa-calendar"></i> Schedule
            </a>

            <a class="nav-link @(currentAction == "Followups" ? "active" : "")"
               asp-controller="Doctor" asp-action="Followups">
                <i class="fa-solid fa-notes-medical"></i> Follow-ups
            </a>

            <a class="nav-link"
               asp-controller="Login" asp-action="Logout">
                <i class="fa-solid fa-right-from-bracket"></i> Logout
            </a>

        </nav>
    </div>

    <!-- CONTENT -->
    <div class="content">
        @RenderBody()
    </div>

    <script>
        const toggleBtn = document.getElementById("menuToggle");
        const sidebar = document.getElementById("sidebar");

        toggleBtn?.addEventListener("click", function () {
            sidebar.classList.toggle("show");
        });
    </script>

</body>
</html>