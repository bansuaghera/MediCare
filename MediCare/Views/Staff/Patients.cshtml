@model IEnumerable<MediCare.Models.Patient>
@{
    ViewData["Title"] = "Patients";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .card-box {
        background: #ffffff;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    }

    .search-box {
        max-width: 350px;
        border-radius: 10px;
    }

    .table th {
        font-size: 13px;
        color: #6b7280;
        font-weight: 600;
        border: none;
    }

    .table td {
        vertical-align: middle;
        border-top: 1px solid #f1f1f1;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        border: none;
        cursor: pointer;
    }

    .status-active {
        background: #d1fae5;
        color: #16a34a;
    }

    .status-inactive {
        background: #e5e7eb;
        color: #6b7280;
    }

    .action-icons a {
        margin-right: 10px;
        cursor: pointer;
        color: #6b7280;
        text-decoration: none;
    }

    .action-icons a:hover {
        color: #16a34a;
    }

    .action-icons button {
        background: transparent;
        border: none;
        color: #6b7280;
        margin-right: 10px;
        cursor: pointer;
    }
    .action-icons button:hover {
        color: #dc2626;
    }

    .pagination-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 15px;
        font-size: 14px;
        color: #6b7280;
    }
</style>

<!-- Page Header -->
<div class="page-header">
    <div>
        <h3 class="fw-bold mb-0">Patients</h3>
        <small class="text-muted">Manage patient records</small>
    </div>

    <a asp-action="RegisterPatient" class="btn btn-success">
        <i class="fa fa-plus me-2"></i> Add Patient
    </a>
</div>

<!-- Card -->
<div class="card-box">

    <!-- Search -->
    <div class="mb-4">
        <input type="text" class="form-control search-box"
               placeholder="Search patients..." id="searchInput" onkeyup="filterTable()" />
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table align-middle" id="patientsTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Patient Name</th>
                    <th>Age/DoB</th>
                    <th>Gender</th>
                    <th>Phone</th>
                    <th>Blood Group</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in Model)
                {
                    <tr>
                        <td>#PT-@patient.Id.ToString("D3")</td>
                        <td class="fw-bold">@patient.FirstName @patient.LastName</td>
                        <td>@patient.DateOfBirth.ToString("dd MMM yyyy")</td>
                        <td>@patient.Gender</td>
                        <td>@patient.Phone</td>
                        <td>@(string.IsNullOrEmpty(patient.BloodGroup) ? "-" : patient.BloodGroup)</td>
                        <td class="action-icons">
                            <a asp-action="Profile" asp-route-id="@patient.Id" title="View Profile"><i class="fa fa-eye"></i></a>
                            <a asp-action="EditPatient" asp-route-id="@patient.Id" title="Edit Patient"><i class="fa fa-pen"></i></a>
                            <form asp-action="DeletePatient" asp-route-id="@patient.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this patient?');">
                                <button type="submit" title="Delete"><i class="fa fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if(!Model.Any())
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">No patients registered.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="pagination-box">
        <span>Showing <strong id="resultCount">@Model.Count()</strong> results</span>
        <div>
            <button class="btn btn-light btn-sm me-2">Previous</button>
            <button class="btn btn-light btn-sm">Next</button>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function filterTable() {
            var searchTerm = document.getElementById("searchInput").value.toLowerCase();
            var rows = document.querySelectorAll("#patientsTable tbody tr");
            var count = 0;

            rows.forEach(function (row) {
                if (row.children.length > 1) { // ignore the empty state row
                    var text = row.textContent.toLowerCase();
                    if (text.includes(searchTerm)) {
                        row.style.display = '';
                        count++;
                    } else {
                        row.style.display = 'none';
                    }
                }
            });
            document.getElementById('resultCount').textContent = count;
        }
    </script>
}

</div>