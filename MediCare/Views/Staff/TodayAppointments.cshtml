                <td>
                    <select class="badge-status in-progress" onchange="this.className = 'badge-status ' + this.value" style="border:none; cursor:pointer;" aria-label="Status">
                        <option value="in-progress" selected>In Progress</option>
                        <option value="waiting">Waiting</option>
                    </select>
                </td>
                <td class="text-end">
                    <div class="action-btn ms-auto">
                        <a asp-action="Profile" style="color: inherit;"><i class="fa fa-eye text-muted"></i></a>
                    </div>
                </td>
            </tr>

