                    </div>
                </td>
            </tr>
        </tbody>
    </table>

    <!-- Pagination -->
    <div class="pagination-box">
        <div>Showing 4 results</div>

        <div class="pagination-buttons">
            <button>Previous</button>
            <button>Next</button>
        </div>
    </div>

