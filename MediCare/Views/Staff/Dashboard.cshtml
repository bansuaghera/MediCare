@{
    ViewData["Title"] = "Staff Dashboard";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<style>
    .stat-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stat-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .icon-green {
        background: #d1fae5;
        color: #16a34a;
    }

    .icon-purple {
        background: #ede9fe;
        color: #7c3aed;
    }

    .icon-pink {
        background: #fce7f3;
        color: #db2777;
    }

    .icon-orange {
        background: #ffedd5;
        color: #ea580c;
    }

    .card-box {
        background: #ffffff;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    }

    .quick-btn {
        width: 100%;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 12px;
    }

    .appointment-item {
        border: 1px solid #f0f0f0;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .appointment-time {
        font-weight: 600;
    }

    .appointment-code {
        color: #16a34a;
        font-weight: 600;
    }
</style>

<h3 class="fw-bold">Staff Dashboard</h3>
<p class="text-muted">Welcome back! Here's today's overview</p>

<!-- Stats Row -->
<div class="row g-4 mt-2">

    <div class="col-md-3">
        <div class="stat-card">
            <div>
                <small class="text-muted">Today's Appointments</small>
                <h4 class="fw-bold mb-0">@ViewBag.TodayCount</h4>
            </div>
            <div class="stat-icon icon-green">
                <i class="fa fa-calendar-check"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div>
                <small class="text-muted">Waiting</small>
                <h4 class="fw-bold mb-0">@ViewBag.WaitingCount</h4>
            </div>
            <div class="stat-icon icon-purple">
                <i class="fa fa-ticket"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div>
                <small class="text-muted">In Progress</small>
                <h4 class="fw-bold mb-0">@ViewBag.InProgressCount</h4>
            </div>
            <div class="stat-icon icon-pink">
                <i class="fa fa-user-plus"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div>
                <small class="text-muted">Completed Today</small>
                <h4 class="fw-bold mb-0">@ViewBag.CompletedCount</h4>
            </div>
            <div class="stat-icon icon-orange">
                <i class="fa fa-clock"></i>
            </div>
        </div>
    </div>

</div>

<div class="row mt-4 g-4">

    <!-- Quick Actions -->
    <div class="col-md-4">
        <div class="card-box">
            <h5 class="fw-bold mb-3">Quick Actions</h5>

            <a asp-action="RegisterPatient" class="btn btn-success quick-btn">
                <i class="fa fa-user-plus me-2"></i> Register Patient
            </a>

            <a asp-controller="Staff"
               asp-action="BookAppointment"
               class="btn btn-outline-secondary quick-btn">
                <i class="fa fa-calendar me-2"></i> Book Appointment
            </a>

            <button class="btn btn-outline-secondary quick-btn">
                <i class="fa fa-ticket me-2"></i> Generate Token
            </button>


        </div>
    </div>

    <!-- Today's Appointments -->
    <div class="col-md-8">
        <div class="card-box">
            <h5 class="fw-bold mb-3">Today's Appointments</h5>

            @if (ViewBag.RecentAppointments != null && ((IEnumerable<MediCare.Models.Appointment>)ViewBag.RecentAppointments).Any())
            {
                foreach (var app in (IEnumerable<MediCare.Models.Appointment>)ViewBag.RecentAppointments)
                {
                    <div class="appointment-item">
                        <div>
                            <div class="appointment-time">@app.AppointmentDate.ToString("hh:mm tt")</div>
                            @app.Patient?.FirstName @app.Patient?.LastName <br />
                            <small class="text-muted">Dr. @app.Doctor?.FirstName @app.Doctor?.LastName</small>
                        </div>
                        <div class="appointment-code">@app.TokenNumber</div>
                    </div>
                }
            }
            else
            {
                <div class="text-muted">No appointments found for today.</div>
            }

        </div>
    </div>

</div>
