@{
    ViewData["Title"] = "Prescriptions";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --primary-green: #00b686;
        --app-bg: #f8f9fa;
        --text-dark: #2d3436;
        --text-muted: #636e72;
        --border-color: #f1f2f6;
    }

    body {
        background-color: var(--app-bg);
    }

    /* Page Header */
    .page-header {
        margin-bottom: 30px;
    }

    /* Search Box */
    .search-box {
        position: relative;
        width: 400px;
        margin-bottom: 25px;
    }

        .search-box input {
            width: 100%;
            padding: 12px 20px 12px 45px;
            border-radius: 14px;
            border: 1px solid #eee;
            background: #f9fafb;
            font-size: 14px;
        }

        .search-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
        }

    /* Card */
    .card-custom {
        border: none;
        border-radius: 24px;
        background: #fff;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        padding: 30px;
    }

    /* Table */
    .table thead {
        background: #f9fafb;
    }

    .table th {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #9ca3af;
        border-bottom: none;
    }

    .table td {
        vertical-align: middle;
        border-top: 1px solid #f1f2f6;
        font-size: 14px;
        color: #374151;
    }

    /* Action Button */
    .action-btn {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        border: 1px solid #f1f2f6;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
    }

        .action-btn:hover {
            background: #f9fafb;
        }

    /* Footer */
    .table-footer {
        margin-top: 20px;
    }

    .pagination-btn {
        border-radius: 10px;
        padding: 6px 16px;
        border: 1px solid #e5e7eb;
        background: #fff;
        font-size: 14px;
    }

        .pagination-btn:hover {
            background: #f9fafb;
        }
</style>

<!-- Top Search + Profile -->
<div class="d-flex justify-content-between align-items-center mb-4">

    <div class="search-box">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search patients, appointments..." />
    </div>

    <div class="d-flex align-items-center gap-3">
        <i class="far fa-bell text-muted"></i>
        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center"
             style="width:38px;height:38px;font-weight:bold;">
            ST
        </div>
    </div>

</div>

<!-- Page Title -->
<div class="page-header">
    <h2 class="fw-bold mb-1">My Prescriptions</h2>
    <p class="text-muted">View all prescriptions</p>
</div>

<!-- Main Card -->
<div class="card-custom">

    <!-- Inner Search -->
    <div class="search-box">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search prescriptions..." />
    </div>

    <div class="table-responsive mt-4">
        <table class="table">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>PATIENT</th>
                    <th>DATE</th>
                    <th>DIAGNOSIS</th>
                    <th>MEDICINES</th>
                    <th class="text-center">ACTIONS</th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td>1</td>
                    <td>John Smith</td>
                    <td>2024-02-12</td>
                    <td>Hypertension</td>
                    <td>3</td>
                    <td class="text-center">
                        <button class="action-btn">
                            <i class="fas fa-eye"></i>
                        </button>
                    </td>
                </tr>

                <tr>
                    <td>2</td>
                    <td>Sarah Johnson</td>
                    <td>2024-02-11</td>
                    <td>Fever</td>
                    <td>2</td>
                    <td class="text-center">
                        <button class="action-btn">
                            <i class="fas fa-eye"></i>
                        </button>
                    </td>
                </tr>

                <tr>
                    <td>3</td>
                    <td>Michael Chen</td>
                    <td>2024-02-10</td>
                    <td>Diabetes Check</td>
                    <td>4</td>
                    <td class="text-center">
                        <button class="action-btn">
                            <i class="fas fa-eye"></i>
                        </button>
                    </td>
                </tr>

            </tbody>
        </table>
    </div>

    <!-- Footer -->
    <div class="d-flex justify-content-between align-items-center table-footer">
        <small class="text-muted">Showing 3 results</small>

        <div>
            <button class="pagination-btn me-2">Previous</button>
            <button class="pagination-btn">Next</button>
        </div>
    </div>

</div>