@model IEnumerable<MediCare.Models.Appointment>
@{
    ViewData["Title"] = "Follow-ups";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 30px;
    }
    .page-header h3 {
        font-weight: 700;
        margin-bottom: 4px;
        color: #1a1a1a;
        font-size: 24px;
    }
    .page-header p {
        color: #6b7280;
        font-size: 14px;
    }

    .table-card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }
    
    .search-box {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 12px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        width: 320px;
        margin-bottom: 30px;
        transition: 0.3s;
    }
    .search-box:focus-within {
        border-color: #10b981;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1);
    }
    .search-box i {
        color: #9ca3af;
        margin-right: 12px;
        font-size: 14px;
    }
    .search-box input {
        border: none;
        background: transparent;
        outline: none;
        width: 100%;
        color: #1a1a1a;
        font-size: 14px;
    }

    .table {
        margin-bottom: 0;
        width: 100%;
        border-collapse: collapse;
    }
    
    .table thead {
        background-color: #f8fafc;
    }

    .table th {
        color: #6b7280;
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: none;
        padding: 16px 20px;
        text-align: left;
    }
    
    .table th:first-child { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
    .table th:last-child { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }

    .table td {
        padding: 20px;
        vertical-align: middle;
        font-size: 13px;
        color: #4b5563;
        border-bottom: 1px solid #f8fafc;
    }
    .table tr:last-child td { border-bottom: none; }

    .patient-name {
        font-weight: 600;
        color: #1a1a1a;
        font-size: 14px;
    }

    .badge-status {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        display: inline-block;
    }
    .status-scheduled { background: #d1fae5; color: #10b981; } /* Light green bg, green text */
    .status-pending { background: #fef3c7; color: #d97706; } /* Light yellow bg, orange text */

    .actions-cell {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: #f1f5f9;
        color: #1a1a1a;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }
    .action-btn:hover {
        background: #e2e8f0;
        color: #10b981;
    }

    .pagination-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 30px;
        font-size: 13px;
        color: #6b7280;
    }
    
    .paginate-btn {
        background: white;
        border: 1px solid #e5e5e5;
        padding: 8px 16px;
        border-radius: 8px;
        color: #4b5563;
        font-weight: 500;
        margin-left: 8px;
        transition: 0.2s;
        cursor: pointer;
        font-size: 13px;
    }
    .paginate-btn:hover {
        background: #f8fafc;
        color: #1a1a1a;
    }
</style>

<div class="page-header">
    <h3>Follow-up Patients</h3>
    <p>Manage follow-up appointments</p>
</div>

<div class="table-card">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap">
        <div class="search-box mb-2 mb-sm-0">
            <i class="fa-solid fa-search"></i>
            <input type="text" placeholder="Search follow-ups..." />
        </div>
        <div id="bulkPanel" class="d-none gap-2 align-items-center">
            <span class="text-muted small fw-bold"><span id="selCount">0</span> selected</span>
            <button class="btn btn-sm btn-danger rounded-pill px-3" onclick="bulkDelete()">Delete Selected</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th style="width:40px;"><input type="checkbox" id="selectAll" class="form-check-input shadow-none" /></th>
                    <th>Patient</th>
                    <th>Last Visit</th>
                    <th>Next Visit</th>
                    <th>Diagnosis</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model)
                {
                    <tr data-id="@appointment.Id">
                        <td><input type="checkbox" class="form-check-input row-check shadow-none" /></td>
                        <td class="patient-name">@(appointment.Patient != null ? $"{appointment.Patient.FirstName} {appointment.Patient.LastName}" : "Unknown")</td>
                        <td>@appointment.AppointmentDate.AddDays(-14).ToString("yyyy-MM-dd")</td> @* Mock last visit *@
                        <td>@appointment.AppointmentDate.ToString("yyyy-MM-dd")</td>
                        <td>@appointment.Subject</td>
                        <td>
                            <select class="badge-status @(appointment.Status == "Scheduled" ? "status-scheduled" : "status-pending")" onchange="updateStatus(@appointment.Id, this)" style="border:none; cursor:pointer; background-color: inherit; outline:none;">
                                <option value="Scheduled" selected="@(appointment.Status == "Scheduled")">Scheduled</option>
                                <option value="Pending" selected="@(appointment.Status == "Pending")">Pending</option>
                            </select>
                        </td>
                        <td>
                            <div class="actions-cell">
                                <a asp-action="Profile" asp-route-id="@appointment.PatientId" class="action-btn text-decoration-none"><i class="fa-regular fa-eye"></i></a>
                                <button class="action-btn" onclick="alert('Call patient: @(appointment.Patient?.Phone)')"><i class="fa-solid fa-phone"></i></button>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No follow-up appointments found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination-bar">
        <span>Showing <strong style="color: #1a1a1a;" id="resultCount">@Model.Count()</strong> results</span>
        <div>
            <button class="paginate-btn">Previous</button>
            <button class="paginate-btn">Next</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector('.search-box input').addEventListener('keyup', function (e) {
            var searchTerm = e.target.value.toLowerCase();
            var rows = document.querySelectorAll('tbody tr');
            var count = 0;

            rows.forEach(function (row) {
                var text = row.textContent.toLowerCase();
                if (text.includes(searchTerm)) {
                    row.style.display = '';
                    count++;
                } else {
                    row.style.display = 'none';
                }
            });
            document.getElementById('resultCount').textContent = count;
        });

        // --- bulk delete ---
        const selectAll = document.getElementById('selectAll');
        const bulkPanel = document.getElementById('bulkPanel');
        const selCount = document.getElementById('selCount');

        selectAll.addEventListener('change', function () {
            document.querySelectorAll('.row-check').forEach(cb => cb.checked = selectAll.checked);
            toggleBulk();
        });

        document.addEventListener('change', function (e) {
            if (e.target.classList.contains('row-check')) toggleBulk();
        });

        function toggleBulk() {
            const count = document.querySelectorAll('.row-check:checked').length;
            selCount.textContent = count;
            bulkPanel.classList.toggle('d-none', count === 0);
        }

        function bulkDelete() {
            if (!confirm("Delete selected follow-up appointments?")) return;
            const ids = [];
            document.querySelectorAll('.row-check:checked').forEach(cb => {
                const id = cb.closest('tr').getAttribute('data-id');
                if (id) ids.push(parseInt(id));
            });
            if (ids.length === 0) return;

            $.ajax({
                url: '/Doctor/BulkDeleteAppointments',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(ids),
                success: function (res) {
                    if (res.success) location.reload();
                    else alert('Unable to delete selected items.');
                }
            });
        }

        function updateStatus(id, selectElement) {
            var status = selectElement.value;
            $.post('/Doctor/UpdateStatus', { id: id, status: status }, function(res) {
                if(res.success) {
                    selectElement.className = "badge-status " + (status === "Scheduled" ? "status-scheduled" : "status-pending");
                } else {
                    alert('Could not update status.');
                    location.reload();
                }
            });
        }
    </script>
}
