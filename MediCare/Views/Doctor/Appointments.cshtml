@{
    ViewData["Title"] = "Today's Appointments";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    body {
        background: #f4f6f9;
    }

    /* ===== Topbar ===== */
    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .search-wrapper {
        position: relative;
        width: 420px;
    }

        .search-wrapper input {
            width: 100%;
            height: 42px;
            border-radius: 14px;
            border: 1px solid #e5e7eb;
            padding-left: 40px;
            background: #f9fafb;
        }

        .search-wrapper i {
            position: absolute;
            top: 13px;
            left: 14px;
            color: #9ca3af;
        }

    .profile-area {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .profile-circle {
        width: 38px;
        height: 38px;
        background: #10b981;
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }

    /* ===== Card ===== */
    .card-custom {
        background: #ffffff;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.05);
    }

    .table thead {
        background: #f3f4f6;
        font-size: 13px;
        color: #6b7280;
    }

    .table th {
        font-weight: 600;
        padding: 14px;
    }

    .table td {
        padding: 16px 14px;
        vertical-align: middle;
    }

    .status-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .badge-progress {
        background: #dbeafe;
        color: #2563eb;
    }

    .badge-waiting {
        background: #fef3c7;
        color: #b45309;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pagination-btn {
        border: 1px solid #e5e7eb;
        background: #fff;
        border-radius: 10px;
        padding: 6px 16px;
    }
</style>

<!-- ===== Topbar ===== -->
<div class="topbar">

    <div class="search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" placeholder="Search patients, appointments..." />
    </div>

    <div class="profile-area">
        <i class="fa fa-bell"></i>
        <div class="profile-circle">DR</div>
    </div>

</div>

<h4 class="fw-bold">Today's Appointments</h4>
<p class="text-muted">View your appointments</p>

<!-- ===== Card ===== -->
<div class="card-custom mt-4">

    <!-- Inner Search -->
    <div class="search-wrapper mb-4" style="width:300px;">
        <i class="fa fa-search"></i>
        <input type="text" placeholder="Search appointments..." />
    </div>

    <table class="table align-middle">
        <thead>
            <tr>
                <th>TIME</th>
                <th>PATIENT</th>
                <th>TYPE</th>
                <th>TOKEN</th>
                <th>STATUS</th>
                <th>ACTIONS</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td><strong>09:00 AM</strong></td>
                <td>John Smith</td>
                <td>Checkup</td>
                <td>A-045</td>
                <td>
                    <span class="status-badge badge-progress">
                        In Progress
                    </span>
                </td>
                <td>
                    <button class="action-btn">
                        <i class="fa fa-eye text-muted"></i>
                    </button>
                </td>
            </tr>

            <tr>
                <td><strong>09:30 AM</strong></td>
                <td>Sarah Johnson</td>
                <td>Consultation</td>
                <td>A-046</td>
                <td>
                    <span class="status-badge badge-waiting">
                        Waiting
                    </span>
                </td>
                <td>
                    <button class="action-btn">
                        <i class="fa fa-eye text-muted"></i>
                    </button>
                </td>
            </tr>

            <tr>
                <td><strong>10:00 AM</strong></td>
                <td>Michael Chen</td>
                <td>Follow-up</td>
                <td>A-047</td>
                <td>
                    <span class="status-badge badge-waiting">
                        Waiting
                    </span>
                </td>
                <td>
                    <button class="action-btn">
                        <i class="fa fa-eye text-muted"></i>
                    </button>
                </td>
            </tr>

            <tr>
                <td><strong>10:30 AM</strong></td>
                <td>Emily Davis</td>
                <td>Checkup</td>
                <td>A-048</td>
                <td>
                    <span class="status-badge badge-waiting">
                        Waiting
                    </span>
                </td>
                <td>
                    <button class="action-btn">
                        <i class="fa fa-eye text-muted"></i>
                    </button>
                </td>
            </tr>

        </tbody>
    </table>

    <!-- Footer -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <small class="text-muted">Showing 4 results</small>

        <div>
            <button class="pagination-btn me-2">Previous</button>
            <button class="pagination-btn">Next</button>
        </div>
    </div>

</div>