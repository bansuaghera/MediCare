
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Staff Panel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        /* Sidebar */
        .sidebar {
            width: 250px;
            height: 100vh;
            background: #ffffff;
            position: fixed;
            padding: 20px 15px;
            border-right: 1px solid #eee;
        }

        .brand {
            display: flex;
            align-items: center;
            margin-bottom: 30px;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            background: #22c55e;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            margin-right: 10px;
        }

        .brand-text strong {
            display: block;
        }

        .nav-link {
            color: #555;
            padding: 10px 12px;
            border-radius: 8px;
            margin-bottom: 5px;
            display: block;
            font-weight: 500;
        }

            .nav-link i {
                width: 20px;
            }

            .nav-link:hover {
                background: #e8f7ed;
                color: #16a34a;
            }

            .nav-link.active {
                background: #d1f5e0;
                color: #0f9b6d !important;
                font-weight: 600;
            }

        .logout {
            position: absolute;
            bottom: 20px;
            left: 20px;
            color: #777;
        }

        /* Content */
        .content {
            margin-left: 250px;
            padding: 25px;
        }

        /* Topbar */
        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .search-box {
            width: 50%;
        }

        .profile {
            width: 35px;
            height: 35px;
            background: #22c55e;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        /* Responsive */
        @@media (max-width: 992px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .content {
                margin-left: 0;
            }
        }
    </style>
</head>

<body>

    <!-- Sidebar -->
    <div class="sidebar">

        <div class="brand">
            <div class="brand-icon">
                <i class="fa-solid fa-heart-pulse"></i>
            </div>
            <div class="brand-text">
                <strong>MediCare</strong>
                <small class="text-muted">Staff Panel</small>
            </div>
        </div>

        <a class="nav-link @(currentAction == "Dashboard" ? "active" : "")" asp-controller="Staff" asp-action="Dashboard">
            <i class="fa fa-chart-line"></i> Dashboard
        </a>

        <a class="nav-link @(currentAction == "RegisterPatient" ? "active" : "")" asp-controller="Staff" asp-action="RegisterPatient">
            <i class="fa fa-user-plus"></i> Register Patient
        </a>

        <a class="nav-link @(currentAction == "Patients" ? "active" : "")" asp-controller="Staff" asp-action="Patients">
            <i class="fa fa-users"></i> Patients
        </a>

        <a class="nav-link @(currentAction == "Appointments" ? "active" : "")" asp-controller="Staff" asp-action="TodayAppointments">
            <i class="fa fa-calendar-check"></i> Appointments
        </a>

        <a class="nav-link @(currentAction == "Tokens" ? "active" : "")" asp-controller="Staff" asp-action="GenerateToken">
            <i class="fa fa-ticket"></i> Tokens
        </a>

        <a class="nav-link @(currentAction == "Queue" ? "active" : "")" asp-controller="Staff" asp-action="Queue">
            <i class="fa fa-list"></i> Queue
        </a>

        <a class="nav-link @(currentAction == "CallToken" ? "active" : "")" asp-controller="Staff" asp-action="CallToken">
            <i class="fa fa-phone"></i> Call Token
        </a>

        <a class="nav-link @(currentAction == "Schedule" ? "active" : "")" asp-controller="Staff" asp-action="Schedule">
            <i class="fa fa-clock"></i> Schedule
        </a>

        <a class="nav-link @(currentAction == "Print" ? "active" : "")" asp-controller="Staff" asp-action="PrintAppointment">
            <i class="fa fa-print"></i> Print
        </a>

        <a asp-controller="Login" asp-action="Logout" class="logout text-decoration-none">
            <i class="fa fa-sign-out-alt me-1"></i> Logout
        </a>

    </div>

    <!-- Content -->
    <div class="content">

        <!-- Topbar -->
        <div class="topbar">
            <input type="text" class="form-control search-box" placeholder="Search patients, appointments..." />
            <div class="profile">ST</div>
        </div>

        @RenderBody()

    </div>

</body>
</html>