@{
    ViewData["Title"] = "My Prescriptions";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<style>
    .page-header h2 {
        font-weight: 700;
    }

    .card-box {
        background: #ffffff;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        margin-top: 25px;
    }

    .search-box {
        max-width: 400px;
        margin-bottom: 20px;
        position: relative;
    }

        .search-box input {
            width: 100%;
            padding: 10px 15px 10px 35px;
            border-radius: 10px;
            border: 1px solid #e5e7eb;
        }

        .search-box i {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
        }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        color: #6b7280;
        font-size: 13px;
        text-transform: uppercase;
    }

    th, td {
        padding: 14px 10px;
        text-align: left;
        border-bottom: 1px solid #f1f1f1;
    }

    tbody tr:hover {
        background: #f9fafb;
    }

    .action-icons i {
        margin-right: 15px;
        cursor: pointer;
        color: #6b7280;
        transition: 0.2s;
    }

        .action-icons i:hover {
            color: #16a34a;
        }

    .pagination-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        color: #6b7280;
        font-size: 14px;
    }

        .pagination-box button {
            padding: 6px 14px;
            border-radius: 8px;
            border: 1px solid #e5e7eb;
            background: white;
            margin-left: 8px;
        }

    @@media (max-width: 768px) {
        table {
            font-size: 13px;
        }

        .search-box {
            max-width: 100%;
        }
    }
</style>

<div class="page-header">
    <h2>My Prescriptions</h2>
    <p class="text-muted">View your prescription history</p>
</div>

<div class="card-box">

    <div class="search-box">
        <i class="fa fa-search"></i>
        <input type="text" placeholder="Search prescriptions..." />
    </div>

    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Doctor</th>
                <th>Diagnosis</th>
                <th>Medicines</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td>2024-02-12</td>
                <td>Dr. Priya Patel</td>
                <td>Hypertension</td>
                <td>3</td>
                <td class="action-icons">
                    <i class="fa fa-eye"></i>
                    <i class="fa fa-download"></i>
                </td>
            </tr>

            <tr>
                <td>2024-02-11</td>
                <td>Dr. Amit Kumar</td>
                <td>Fever</td>
                <td>2</td>
                <td class="action-icons">
                    <i class="fa fa-eye"></i>
                    <i class="fa fa-download"></i>
                </td>
            </tr>

            <tr>
                <td>2024-02-10</td>
                <td>Dr. Neha Singh</td>
                <td>Diabetes Check</td>
                <td>4</td>
                <td class="action-icons">
                    <i class="fa fa-eye"></i>
                    <i class="fa fa-download"></i>
                </td>
            </tr>
        </tbody>
    </table>

    <div class="pagination-box">
        <div>Showing 3 results</div>
        <div>
            <button>Previous</button>
            <button>Next</button>
        </div>
    </div>

</div>