@model MediCare.Models.ViewModels.DoctorDashboardViewModel
@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 30px;
    }

    .page-header h3 {
        font-weight: 700;
        margin-bottom: 4px;
        color: #1a1a1a;
        font-size: 24px;
    }

    .page-header p {
        color: #6b7280;
        font-size: 14px;
    }

    /* Stats Grid */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    @@media (min-width: 1200px) {
        .stats-row {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .stat-info h2 {
        font-size: 32px;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
        line-height: 1;
    }

    .stat-info p {
        margin: 8px 0 0 0;
        color: #6b7280;
        font-size: 14px;
        font-weight: 500;
        line-height: 1.4;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .icon-green { background: #d1fae5; color: #10b981; }
    .icon-blue { background: #dbeafe; color: #3b82f6; }
    .icon-purple { background: #f3e8ff; color: #a855f7; }
    .icon-orange { background: #ffedd5; color: #f97316; }

    /* Main Grid */
    .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 24px;
    }

    @@media (min-width: 992px) {
        .dashboard-grid {
            grid-template-columns: 2fr 1fr;
        }
    }

    .content-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .content-card h4 {
        font-size: 18px;
        font-weight: 700;
        color: #1a1a1a;
        margin-top: 0;
        margin-bottom: 24px;
    }

    /* Appointments List */
    .appointment-item {
        display: flex;
        align-items: center;
        padding: 16px;
        border: 1px solid #f1f5f9;
        border-radius: 12px;
        margin-bottom: 12px;
        transition: all 0.2s;
    }

    .appointment-item:hover {
        border-color: #e2e8f0;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }
    
    .appointment-item:last-child {
        margin-bottom: 0;
    }

    .time-slot {
        width: 100px;
        font-weight: 600;
        color: #1a1a1a;
        font-size: 14px;
    }

    .patient-details {
        flex: 1;
    }

    .patient-details h5 {
        margin: 0 0 4px 0;
        font-size: 15px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .patient-details p {
        margin: 0;
        font-size: 13px;
        color: #6b7280;
    }

    .status-badge {
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-in-progress { background: #eff6ff; color: #3b82f6; }
    .status-waiting { background: #fff7ed; color: #f97316; }
    .status-scheduled { background: #f8fafc; color: #64748b; }

    /* Quick Stats */
    .quick-stat-item {
        margin-bottom: 30px;
        padding-bottom: 24px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .quick-stat-item:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: none;
    }

    .quick-stat-label {
        font-size: 14px;
        color: #6b7280;
    }

    .quick-stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
        line-height: 1;
    }

    /* Progress Bar */
    .progress-container {
        margin-top: 30px;
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 13px;
    }

    .progress-title { color: #6b7280; font-weight: 500; }
    .progress-value { font-weight: 700; color: #10b981; }

    .progress-bar-bg {
        height: 6px;
        background: #f1f5f9;
        border-radius: 4px;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        background: #10b981;
        width: 33%;
        border-radius: 4px;
    }
</style>

<div class="page-header">
    <h3>Doctor Dashboard</h3>
    <p>Welcome back, @(Context.Session.GetString("UserName") ?? "Dr. Priya Patel") 👋</p>
</div>

<div class="stats-row">
    <div class="stat-card">
        <div class="stat-info">
            <h2>@Model.TodayAppointmentsCount</h2>
            <p>Today's<br/>Appointments</p>
        </div>
        <div class="stat-icon icon-green">
            <i class="fa-regular fa-calendar-check"></i>
        </div>
    </div>
    
    <div class="stat-card">
        <div class="stat-info">
            <h2>@Model.WaitingPatientsCount</h2>
            <p>Waiting<br/>Patients</p>
        </div>
        <div class="stat-icon icon-blue">
            <i class="fa-regular fa-user"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <h2>@Model.CompletedAppointmentsCount</h2>
            <p>Completed</p>
        </div>
        <div class="stat-icon icon-purple">
            <i class="fa-regular fa-circle-check"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <h2>@Model.TomorrowAppointmentsCount</h2>
            <p>Tomorrow</p>
        </div>
        <div class="stat-icon icon-orange">
            <i class="fa-regular fa-clock"></i>
        </div>
    </div>
</div>

<div class="dashboard-grid">
    <div class="content-card">
        <h4>Today's Appointments</h4>
        
        <div class="appointment-list">
            @if (Model.TodayAppointments != null && Model.TodayAppointments.Any())
            {
                @foreach (var appointment in Model.TodayAppointments)
                {
                    <div class="appointment-item">
                        <div class="time-slot">@appointment.AppointmentDate.ToString("hh:mm tt")</div>
                        <div class="patient-details">
                            <h5>@(appointment.Patient?.FirstName + " " + appointment.Patient?.LastName)</h5>
                            <p>@appointment.Subject &bull; Token: @appointment.TokenNumber</p>
                        </div>
                        <div class="status-badge status-@(appointment.Status?.ToLower().Replace(" ", "-") ?? "scheduled")">
                            @appointment.Status
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <p>No appointments for today.</p>
                </div>
            }
        </div>
    </div>

    <div class="content-card">
        <h4>Quick Stats</h4>

        <div class="quick-stat-item">
            <div class="quick-stat-label">Total Patients</div>
            <div class="quick-stat-value">@Model.TotalPatientsCount</div>
        </div>

        <div class="quick-stat-item">
            <div class="quick-stat-label">Avg Consultation Time</div>
            <div class="quick-stat-value">18 min</div>
        </div>

        <div class="quick-stat-item" style="border-bottom: none; margin-bottom: 0; padding-bottom: 0;">
            <div class="quick-stat-label">Prescriptions Issued</div>
            <div class="quick-stat-value">@Model.PrescriptionsIssuedCount</div>
            
            <div class="progress-container">
                <div class="progress-header">
                    <span class="progress-title">Today's Progress</span>
                    <span class="progress-value">@Model.TodayProgressPercentage.ToString("0")%</span>
                </div>
                <div class="progress-bar-bg">
                    <div class="progress-bar-fill" style="width: @Model.TodayProgressPercentage.ToString("0")%;"></div>
                </div>
            </div>
        </div>
    </div>
</div>