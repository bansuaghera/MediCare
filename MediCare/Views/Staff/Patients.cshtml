@{
    ViewData["Title"] = "Patients";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .card-box {
        background: #ffffff;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    }

    .search-box {
        max-width: 350px;
        border-radius: 10px;
    }

    .table th {
        font-size: 13px;
        color: #6b7280;
        font-weight: 600;
        border: none;
    }

    .table td {
        vertical-align: middle;
        border-top: 1px solid #f1f1f1;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .status-active {
        background: #d1fae5;
        color: #16a34a;
    }

    .status-inactive {
        background: #e5e7eb;
        color: #6b7280;
    }

    .action-icons i {
        margin-right: 10px;
        cursor: pointer;
        color: #6b7280;
    }

        .action-icons i:hover {
            color: #16a34a;
        }

    .pagination-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 15px;
        font-size: 14px;
        color: #6b7280;
    }
</style>

<!-- Page Header -->
<div class="page-header">
    <div>
        <h3 class="fw-bold mb-0">Patients</h3>
        <small class="text-muted">Manage patient records</small>
    </div>

    <a asp-action="RegisterPatient" class="btn btn-success">
        <i class="fa fa-plus me-2"></i> Add Patient
    </a>
</div>

<!-- Card -->
<div class="card-box">

    <!-- Search -->
    <div class="mb-4">
        <input type="text" class="form-control search-box"
               placeholder="Search patients..." />
    </div>

    <!-- Table -->
    <table class="table align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Patient Name</th>
                <th>Age</th>
                <th>Gender</th>
                <th>Phone</th>
                <th>Last Visit</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>

            <tr>
                <td>1</td>
