                <td>45</td>
                <td>Male</td>
                <td>+1 234-567-8900</td>
                <td>2024-02-10</td>
                <td><span class="status-badge status-active">Active</span></td>
                <td class="action-icons">
                    <i class="fa fa-eye"></i>
                    <i class="fa fa-pen"></i>
                    <i class="fa fa-trash"></i>
                </td>
            </tr>

            <tr>
                <td>2</td>
                <td>Sarah Johnson</td>
                <td>32</td>
                <td>Female</td>
                <td>+1 234-567-8901</td>
                <td>2024-02-09</td>
                <td><span class="status-badge status-active">Active</span></td>
                <td class="action-icons">
                    <i class="fa fa-eye"></i>
                    <i class="fa fa-pen"></i>
                    <i class="fa fa-trash"></i>
                </td>
            </tr>

            <tr>
                <td>3</td>
                <td>Michael Chen</td>
                <td>58</td>
                <td>Male</td>
                <td>+1 234-567-8902</td>
                <td>2024-01-28</td>
                <td><span class="status-badge status-inactive">Inactive</span></td>
                <td class="action-icons">
                    <i class="fa fa-eye"></i>
                    <i class="fa fa-pen"></i>
                    <i class="fa fa-trash"></i>
                </td>
            </tr>

            <tr>
                <td>4</td>
                <td>Emily Davis</td>
                <td>28</td>
                <td>Female</td>
                <td>+1 234-567-8903</td>
                <td>2024-02-11</td>
                <td><span class="status-badge status-active">Active</span></td>
                <td class="action-icons">
                    <i class="fa fa-eye"></i>
                    <i class="fa fa-pen"></i>
                    <i class="fa fa-trash"></i>
                </td>
            </tr>

            <tr>
                <td>5</td>
                <td>Robert Wilson</td>
                <td>41</td>
                <td>Male</td>
                <td>+1 234-567-8904</td>
                <td>2024-02-08</td>
                <td><span class="status-badge status-active">Active</span></td>
                <td class="action-icons">
                    <i class="fa fa-eye"></i>
                    <i class="fa fa-pen"></i>
                    <i class="fa fa-trash"></i>
                </td>
            </tr>

        </tbody>
    </table>

    <!-- Pagination -->
    <div class="pagination-box">
        <span>Showing 5 results</span>
        <div>
            <button class="btn btn-light btn-sm me-2">Previous</button>
            <button class="btn btn-light btn-sm">Next</button>
        </div>
    </div>

</div>