@{
    ViewData["Title"] = "My Appointments";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<style>
    .page-header h2 {
        font-weight: 700;
    }

    .appointment-card {
        background: #ffffff;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.05);
        margin-top: 20px;
        transition: 0.3s;
    }

        .appointment-card:hover {
            transform: translateY(-3px);
        }

    .appointment-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .doctor-name {
        font-weight: 700;
        font-size: 18px;
    }

    .speciality {
        color: #6b7280;
        font-size: 14px;
    }

    .status-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .confirmed {
        background: #e5e7eb;
        color: #374151;
    }

    .completed {
        background: #e5e7eb;
        color: #6b7280;
    }

    .appointment-details {
        display: flex;
        gap: 40px;
        margin: 15px 0;
        color: #374151;
        font-size: 14px;
    }

        .appointment-details i {
            margin-right: 6px;
        }

    .btn-reschedule {
        background: #e5e7eb;
        border: none;
        padding: 8px 18px;
        border-radius: 10px;
        font-weight: 600;
    }

    .btn-cancel {
        background: #fee2e2;
        color: #dc2626;
        border: none;
        padding: 8px 18px;
        border-radius: 10px;
        font-weight: 600;
        margin-left: 10px;
    }

    @@media (max-width: 768px) {
        .appointment-details {
            flex-direction: column;
            gap: 8px;
        }
    }
</style>

<div class="page-header">
    <h2>My Appointments</h2>
    <p class="text-muted">View and manage your appointments</p>
</div>

<!-- Appointment 1 -->
<div class="appointment-card">
    <div class="appointment-top">
        <div>
            <div class="doctor-name">Dr. Sarah Johnson</div>
            <div class="speciality">Cardiology</div>
        </div>
        <span class="status-badge confirmed">Confirmed</span>
    </div>

    <div class="appointment-details">
        <div><i class="fa fa-calendar"></i> 2024-02-15</div>
        <div><i class="fa fa-clock"></i> 10:00 AM</div>
        <div><i class="fa fa-location-dot"></i> Room 101</div>
    </div>

    <button class="btn-reschedule">Reschedule</button>
    <button class="btn-cancel">Cancel</button>
</div>

