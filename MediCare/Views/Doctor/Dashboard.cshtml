@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    body {
        background: #f4f6f9;
    }

    /* ===== Topbar ===== */
    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .search-wrapper {
        position: relative;
        width: 420px;
    }

        .search-wrapper input {
            width: 100%;
            height: 45px;
            border-radius: 14px;
            border: 1px solid #e5e7eb;
            padding-left: 40px;
            background: #f9fafb;
        }

        .search-wrapper i {
            position: absolute;
            top: 14px;
            left: 14px;
            color: #9ca3af;
        }

    .profile-area {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .profile-circle {
        width: 40px;
        height: 40px;
        background: #10b981;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }

    /* ===== Cards ===== */
    .card-custom {
        background: #fff;
        border-radius: 20px;
        padding: 20px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.05);
    }

    .stat-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stat-number {
        font-size: 22px;
        font-weight: 700;
    }

    .icon-box {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .green {
        background: #d1fae5;
        color: #059669;
    }

    .blue {
        background: #dbeafe;
        color: #2563eb;
    }

    .purple {
        background: #ede9fe;
        color: #7c3aed;
    }

    .orange {
        background: #ffedd5;
        color: #f97316;
    }

    .appointment-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px;
        border: 1px solid #f1f1f1;
        border-radius: 14px;
        margin-bottom: 12px;
    }

    .status-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .progress-bar-custom {
        height: 6px;
        background: #e5e7eb;
        border-radius: 20px;
        overflow: hidden;
        margin-top: 10px;
    }

    .progress-fill {
        height: 100%;
        width: 33%;
        background: #10b981;
    }
</style>

<!-- ===== Topbar ===== -->
<div class="topbar">

    <div class="search-wrapper">
        <i class="fa fa-search"></i>
        <input type="text" placeholder="Search patients, appointments..." />
    </div>

    <div class="profile-area">
        <i class="fa fa-bell"></i>
        <div class="profile-circle">DR</div>
    </div>

</div>

<h4 class="fw-bold">Doctor Dashboard</h4>
<p class="text-muted">Welcome back, Dr. Sarah Johnson</p>

<!-- ===== Stats Row ===== -->
<div class="row g-4 mt-3">

    <div class="col-md-3">
        <div class="card-custom stat-card">
            <div>
                <div class="stat-number">12</div>
                <small class="text-muted">Today's Appointments</small>
            </div>
            <div class="icon-box green">
                <i class="fa fa-calendar"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card-custom stat-card">
            <div>
                <div class="stat-number">8</div>
                <small class="text-muted">Waiting Patients</small>
            </div>
            <div class="icon-box blue">
                <i class="fa fa-user"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card-custom stat-card">
            <div>
                <div class="stat-number">4</div>
                <small class="text-muted">Completed</small>
            </div>
            <div class="icon-box purple">
                <i class="fa fa-check"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card-custom stat-card">
            <div>
                <div class="stat-number">15</div>
                <small class="text-muted">Tomorrow</small>
            </div>
            <div class="icon-box orange">
                <i class="fa fa-clock"></i>
            </div>
        </div>
    </div>

</div>

<!-- ===== Content Row ===== -->
<div class="row mt-4 g-4">

    <!-- Today's Appointments -->
    <div class="col-md-8">
        <div class="card-custom">
            <h5 class="fw-bold mb-3">Today's Appointments</h5>

            <div class="appointment-item">
                <div>
                    <strong>09:00 AM</strong><br />
                    John Smith<br />
                    <small class="text-muted">Checkup • Token: A-045</small>
                </div>
                <span class="status-badge bg-primary text-white">In Progress</span>
            </div>

            <div class="appointment-item">
                <div>
                    <strong>09:30 AM</strong><br />
                    Sarah Johnson<br />
                    <small class="text-muted">Consultation • Token: A-046</small>
                </div>
                <span class="status-badge bg-warning text-dark">Waiting</span>
            </div>

            <div class="appointment-item">
                <div>
                    <strong>10:00 AM</strong><br />
                    Michael Chen<br />
                    <small class="text-muted">Follow-up • Token: A-047</small>
                </div>
                <span class="status-badge bg-warning text-dark">Waiting</span>
            </div>

        </div>
    </div>

    <!-- Quick Stats -->
    <div class="col-md-4">
        <div class="card-custom">
            <h5 class="fw-bold mb-4">Quick Stats</h5>

            <p class="mb-1 text-muted">Total Patients</p>
            <h4>156</h4>

            <p class="mt-3 mb-1 text-muted">Avg Consultation Time</p>
            <h4>18 min</h4>

            <p class="mt-3 mb-1 text-muted">Prescriptions Issued</p>
            <h4>142</h4>

            <p class="mt-4 mb-1 text-muted">Today's Progress</p>
            <div class="progress-bar-custom">
                <div class="progress-fill"></div>
            </div>
            <small class="text-success">33%</small>

        </div>
    </div>

</div>