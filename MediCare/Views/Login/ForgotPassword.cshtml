@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Forgot Password - MediCare+</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="~/css/forgotPassword.css" rel="stylesheet" />
</head>

<body>

        <div class="forgot-password-container">

            <!-- LEFT SIDE -->
            <div class="left-section">
                <div class="left-content">
                    <h1>Don't Worry!</h1>
                    <p>
                        Forgot your password? No problem! We'll send you a reset link to get you back into your
                        account quickly and securely.
                    </p>

                    <ul class="steps-list">
                        <li>1. Enter your email</li>
                        <li>2. Check your inbox</li>
                        <li>3. Create new password</li>
                    </ul>
                </div>
            </div>

            <!-- RIGHT SIDE -->
            <div class="right-section">
                <div class="forgot-card">

                    <div class="mail-icon-box">
                        <i class="fa-regular fa-envelope mail-icon"></i>
                    </div>

                    <h2>Forgot Password?</h2>
                    <p class="subtitle">
                        Enter your email address and we'll send instructions to reset your password.
                    </p>

                    @if (ViewBag.Error != null)
                    {
                        <div style="background-color: #fee2e2; color: #dc2626; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; font-weight: 500;">
                            @ViewBag.Error
                        </div>
                    }

                    @if (ViewBag.Success != null)
                    {
                        <div style="background-color: #d1fae5; color: #047857; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; font-weight: 500;">
                            @ViewBag.Success
                        </div>
                    }

                    <form asp-controller="Login" asp-action="ForgotPassword" method="post" class="forgot-form">
                        <div class="input-group">
                            <label>Email Address</label>
                            <input type="email" name="Email" placeholder="Enter your email" required />
                        </div>

                        <button type="submit" class="reset-btn">
                            <i class="fa-solid fa-paper-plane" style="font-size: 18px;"></i>
                            <span>Send Reset Link</span>
                        </button>
                    </form>

                    <a asp-controller="Login" asp-action="Login" class="back-to-login">
                        <i class="fa-solid fa-arrow-left" style="font-size: 18px;"></i>
                        <span>Back to Login</span>
                    </a>

                </div>
            </div>

        </div>

</body>
</html>