@{
    ViewData["Title"] = "Analytics";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Analytics</h2>
        <p class="text-muted mb-0">Doctor performance and patient flow</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card border-0 shadow-sm rounded-4 p-3"><small class="text-muted">Patients</small><h3 class="fw-bold mb-0">@ViewBag.TotalPatients</h3></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm rounded-4 p-3"><small class="text-muted">Appointments</small><h3 class="fw-bold mb-0">@ViewBag.TotalAppointments</h3></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm rounded-4 p-3"><small class="text-muted">Waiting</small><h3 class="fw-bold mb-0">@ViewBag.WaitingCount</h3></div></div>
    <div class="col-md-3"><div class="card border-0 shadow-sm rounded-4 p-3"><small class="text-muted">Completed</small><h3 class="fw-bold mb-0">@ViewBag.CompletedCount</h3></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold mb-3">Weekly Appointment Trend</h5>
            <div style="position:relative; height:320px;">
                <canvas id="doctorTrend"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold mb-3">Today Status Mix</h5>
            <div style="position:relative; height:320px;">
                <canvas id="doctorStatus"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    new Chart(document.getElementById('doctorTrend'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(ViewBag.DailyTrendLabels ?? new List<string>())),
            datasets: [{
                label: 'Appointments',
                data: @Html.Raw(Json.Serialize(ViewBag.DailyTrendData ?? new List<int>())),
                backgroundColor: '#10b981',
                borderRadius: 10
            }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
    });

    new Chart(document.getElementById('doctorStatus'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(Json.Serialize(ViewBag.ChartLabels ?? new List<string>())),
            datasets: [{
                data: @Html.Raw(Json.Serialize(ViewBag.ChartData ?? new List<int>())),
                backgroundColor: ['#f59e0b', '#3b82f6', '#10b981', '#ef4444']
            }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
    });
</script>
