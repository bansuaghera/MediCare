@{
    ViewData["Title"] = "Appointments";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    .page-header {
        margin-bottom: 30px;
    }
    .page-header h3 {
        font-weight: 700;
        margin-bottom: 4px;
        color: #1a1a1a;
        font-size: 24px;
    }
    .page-header p {
        color: #6b7280;
        font-size: 14px;
    }

    .table-card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }
    
    .search-box {
        background: #f8fafc;
        border: 1px solid transparent;
        border-radius: 24px;
        padding: 12px 20px;
        display: flex;
        align-items: center;
        width: 320px;
        margin-bottom: 30px;
        transition: 0.3s;
    }
    .search-box:focus-within {
        border-color: #10b981;
        background: #fff;
    }
    .search-box i {
        color: #9ca3af;
        margin-right: 12px;
        font-size: 14px;
    }
    .search-box input {
        border: none;
        background: transparent;
        outline: none;
        width: 100%;
        color: #1a1a1a;
        font-size: 14px;
    }

    .table {
        margin-bottom: 0;
        width: 100%;
        border-collapse: collapse;
    }
    
    .table thead {
        background-color: #f8fafc;
    }

    .table th {
        color: #6b7280;
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: none;
        padding: 16px 20px;
        text-align: left;
    }
    
    .table th:first-child { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
    .table th:last-child { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }

    .table td {
        padding: 20px;
        vertical-align: middle;
        font-size: 13px;
        color: #4b5563;
        border-bottom: 1px solid #f8fafc;
    }
    .table tr:last-child td { border-bottom: none; }

    .patient-name {
        font-weight: 600;
        color: #1a1a1a;
        font-size: 14px;
    }
    
    .badge-status {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        display: inline-block;
    }
    .status-progress { background: #dbeafe; color: #3b82f6; } 
    .status-waiting { background: #fef3c7; color: #d97706; }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: white;
        color: #6b7280;
        border: 1px solid #e5e5e5;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }
    .action-btn:hover {
        background: #f8fafc;
        color: #10b981;
        border-color: #10b981;
    }

    .pagination-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 30px;
        font-size: 13px;
        color: #6b7280;
    }
    
    .paginate-btn {
        background: white;
        border: 1px solid #e5e5e5;
        padding: 8px 16px;
        border-radius: 8px;
        color: #4b5563;
        font-weight: 500;
        margin-left: 8px;
        transition: 0.2s;
        font-size: 13px;
        cursor: pointer;
    }
    .paginate-btn:hover {
        background: #f8fafc;
        color: #1a1a1a;
    }
</style>

<div class="page-header">
    <h3>Today's Appointments</h3>
    <p>View your appointments</p>
</div>

<div class="table-card">
    <div class="search-box">
        <i class="fa-solid fa-search"></i>
        <input type="text" placeholder="Search appointments..." />
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Patient</th>
                    <th>Type</th>
                    <th>Token</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>09:00 AM</td>
                    <td class="patient-name">Rahul Sharma</td>
                    <td>Checkup</td>
                    <td>A-045</td>
                    <td>
                        <select class="badge-status status-progress" onchange="this.className = 'badge-status ' + this.value" style="border:none; cursor:pointer; background-color: inherit;">
                            <option value="status-progress" selected>In Progress</option>
                            <option value="status-waiting">Waiting</option>
                        </select>
                    </td>
                    <td><a asp-action="Profile" class="action-btn text-decoration-none"><i class="fa-regular fa-eye"></i></a></td>
                </tr>
                <tr>
                    <td>09:30 AM</td>
                    <td class="patient-name">Priya Patel</td>
                    <td>Consultation</td>
                    <td>A-046</td>
                    <td>
                        <select class="badge-status status-waiting" onchange="this.className = 'badge-status ' + this.value" style="border:none; cursor:pointer; background-color: inherit;">
                            <option value="status-progress">In Progress</option>
                            <option value="status-waiting" selected>Waiting</option>
                        </select>
                    </td>
                    <td><a asp-action="Profile" class="action-btn text-decoration-none"><i class="fa-regular fa-eye"></i></a></td>
                </tr>
                <tr>
                    <td>10:00 AM</td>
                    <td class="patient-name">Amit Kumar</td>
                    <td>Follow-up</td>
                    <td>A-047</td>
                    <td>
                        <select class="badge-status status-waiting" onchange="this.className = 'badge-status ' + this.value" style="border:none; cursor:pointer; background-color: inherit;">
                            <option value="status-progress">In Progress</option>
                            <option value="status-waiting" selected>Waiting</option>
                        </select>
                    </td>
                    <td><a asp-action="Profile" class="action-btn text-decoration-none"><i class="fa-regular fa-eye"></i></a></td>
                </tr>
                <tr>
                    <td>10:30 AM</td>
                    <td class="patient-name">Neha Singh</td>
                    <td>Checkup</td>
                    <td>A-048</td>
                    <td>
                        <select class="badge-status status-waiting" onchange="this.className = 'badge-status ' + this.value" style="border:none; cursor:pointer; background-color: inherit;">
                            <option value="status-progress">In Progress</option>
                            <option value="status-waiting" selected>Waiting</option>
                        </select>
                    </td>
                    <td><a asp-action="Profile" class="action-btn text-decoration-none"><i class="fa-regular fa-eye"></i></a></td>
                </tr>
                <tr>
                    <td>11:00 AM</td>
                    <td class="patient-name">Vikram Desai</td>
                    <td>Consultation</td>
                    <td>A-049</td>
                    <td>
                        <select class="badge-status status-waiting" onchange="this.className = 'badge-status ' + this.value" style="border:none; cursor:pointer; background-color: inherit;">
                            <option value="status-progress">In Progress</option>
                            <option value="status-waiting" selected>Waiting</option>
                        </select>
                    </td>
                    <td><a asp-action="Profile" class="action-btn text-decoration-none"><i class="fa-regular fa-eye"></i></a></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="pagination-bar">
        <span>Showing <span style="color: #1a1a1a; font-weight: 600;" id="resultCount">4</span> results</span>
        <div>
            <button class="paginate-btn">Previous</button>
            <button class="paginate-btn">Next</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector('.search-box input').addEventListener('keyup', function (e) {
            var searchTerm = e.target.value.toLowerCase();
            var rows = document.querySelectorAll('tbody tr');
            var count = 0;

            rows.forEach(function (row) {
                var text = row.textContent.toLowerCase();
                if (text.includes(searchTerm)) {
                    row.style.display = '';
                    count++;
                } else {
                    row.style.display = 'none';
                }
            });
            document.getElementById('resultCount').textContent = count;
        });
    </script>
}
