@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Reset Password - MediCare+</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="~/css/verifyOTP.css" rel="stylesheet" />
</head>

<body>

        <div class="verify-otp-container">

            <!-- LEFT SIDE -->
            <div class="left-section">
                <div class="left-content">
                    <h1>Create New Password</h1>
                    <p>
                        Your OTP is verified. Now set a strong and secure password.
                    </p>
                </div>
            </div>

            <!-- RIGHT SIDE -->
            <div class="right-section">
                <div class="otp-card" style="max-width:400px; padding:40px;">

                    <div class="shield-icon-box">
                        <i class="fa-solid fa-lock shield-icon"></i>
                    </div>

                    <h2>Reset Password</h2>
                    <p class="subtitle">
                        Enter your new password below
                    </p>

                    @if (ViewBag.Error != null)
                    {
                        <div style="background-color: #fee2e2; color: #dc2626; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; font-weight: 500;">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-action="ResetPassword" method="post" class="otp-form">

                        <div class="otp-input-group" style="flex-direction: column; gap:15px; margin-bottom: 20px;">
                            <input
                                type="password"
                                name="NewPassword"
                                style="width: 100%; border: none; background: #f1f5f9; border-radius: 12px; font-size: 16px; color: #1e293b; padding: 15px;"
                                placeholder="New Password"
                                required
                            />
                            <input
                                type="password"
                                name="ConfirmPassword"
                                style="width: 100%; border: none; background: #f1f5f9; border-radius: 12px; font-size: 16px; color: #1e293b; padding: 15px;"
                                placeholder="Confirm Password"
                                required
                            />
                        </div>

                        <button type="submit" class="verify-btn">
                            Update Password
                        </button>
                    </form>

                </div>
            </div>

        </div>

</body>
</html>