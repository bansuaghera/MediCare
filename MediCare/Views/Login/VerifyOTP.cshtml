@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Verify OTP - MediCare+</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI';
        }

        .wrapper {
            display: flex;
            height: 100vh;
        }

        .left {
            flex: 1;
            background: linear-gradient(135deg,#16a34a,#14b8a6);
            color: white;
            padding: 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .right {
            flex: 1;
            background: #f4f6f9;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card-box {
            width: 420px;
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.1);
            text-align: center;
        }

        .form-control {
            height: 50px;
            border-radius: 12px;
            text-align: center;
            font-size: 20px;
            letter-spacing: 4px;
        }

        .btn-custom {
            background: linear-gradient(135deg,#16a34a,#14b8a6);
            border: none;
            height: 45px;
            border-radius: 12px;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="wrapper">

        <!-- LEFT PANEL -->
        <div class="left">
            <h1>Verify Your OTP</h1>
            <p class="mt-4">
                We've sent a 6-digit verification code to your email.
                Please enter it below to continue.
            </p>
        </div>

        <!-- RIGHT PANEL -->
        <div class="right">

            <div class="card-box">

                <i class="fa-solid fa-shield-halved fa-2x text-success mb-3"></i>

                <h3>Enter OTP</h3>
                <p class="text-muted">Check your email for the verification code</p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-action="VerifyOTP" method="post">

                    <div class="mb-3">
                        <input type="text" name="UserOTP" maxlength="6"
                               class="form-control"
                               placeholder="------" required />
                    </div>

                    <button type="submit" class="btn btn-custom w-100 text-white">
                        Verify OTP
                    </button>

                    <div class="mt-3">
                        <a asp-action="Login" class="text-dark">← Back to Login</a>
                    </div>

                </form>

            </div>

        </div>

    </div>

</body>
</html>