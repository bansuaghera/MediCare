@model IEnumerable<MediCare.Models.Appointment>
@{
    ViewData["Title"] = "Real-time Token Queue";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var currentTokens = ViewBag.CurrentTokens as System.Collections.Concurrent.ConcurrentDictionary<int, string>;
}

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
        --secondary-gradient: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        --glass-bg: rgba(255, 255, 255, 0.9);
        --glass-border: rgba(255, 255, 255, 0.2);
    }

    .dashboard-header {
        background: var(--primary-gradient);
        padding: 40px;
        border-radius: 24px;
        color: white;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(16, 185, 129, 0.2);
    }

    .dashboard-header::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -10%;
        width: 300px;
        height: 300px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        pointer-events: none;
    }

    .token-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 24px;
    }

    .token-card {
        background: white;
        border-radius: 20px;
        padding: 24px;
        border: 1px solid #f1f5f9;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
    }

    .token-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.05);
    }

    .now-serving-badge {
        background: #fee2e2;
        color: #ef4444;
        padding: 4px 12px;
        border-radius: 100px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        display: inline-block;
        margin-bottom: 12px;
    }

    .token-number {
        font-size: 48px;
        font-weight: 800;
        color: #1e293b;
        margin: 12px 0;
        font-family: 'Inter', sans-serif;
    }

    .doctor-info {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px dashed #e2e8f0;
    }

    .doctor-avatar {
        width: 40px;
        height: 40px;
        background: #f1f5f9;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
    }

    .patient-queue-list {
        background: white;
        border-radius: 20px;
        padding: 30px;
        margin-top: 40px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .status-pill {
        padding: 4px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
    }

    .status-waiting { background: #eff6ff; color: #3b82f6; }

    .serve-btn {
        background: var(--primary-gradient);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 600;
        transition: 0.2s;
    }

    .serve-btn:hover {
        opacity: 0.9;
        transform: scale(1.02);
    }

</style>

<div class="dashboard-header h-100">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold mb-2">OPD Queue Monitor</h1>
            <p class="mb-0 opacity-75">Live tracking of patient sessions across all departments</p>
        </div>
        <div class="text-end">
            <div class="fs-4 fw-bold">@DateTime.Now.ToString("hh:mm tt")</div>
            <div class="opacity-75">@DateTime.Now.ToString("dd MMM yyyy")</div>
        </div>
    </div>
</div>

<div class="token-grid">
    @foreach (var doctor in Model.Select(m => m.Doctor).DistinctBy(d => d.Id))
    {
        var currentToken = currentTokens?.ContainsKey(doctor.Id) == true ? currentTokens[doctor.Id] : "---";
        <div class="token-card shadow-sm">
            <div class="now-serving-badge">Now Serving</div>
            <div class="token-number">#@currentToken</div>
            <div class="doctor-info">
                <div class="doctor-avatar">
                    <i class="fa-solid fa-user-md"></i>
                </div>
                <div>
                    <div class="fw-bold text-slate-800">Dr. @doctor.FirstName @doctor.LastName</div>
                    <div class="text-sm text-slate-500">@doctor.Specialty</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="patient-queue-list">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold m-0">Waiting List (Today)</h4>
        <span class="badge bg-slate-100 text-slate-600 rounded-pill px-3 py-2">@Model.Count() Patients Waiting</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr class="text-slate-500 small text-uppercase">
                    <th>Token</th>
                    <th>Patient Name</th>
                    <th>Doctor</th>
                    <th>Time Slot</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in Model)
                {
                    <tr>
                        <td class="fw-bold fs-5">#@appt.TokenNumber</td>
                        <td>
                            <div class="fw-semibold">@appt.Patient?.FirstName @appt.Patient?.LastName</div>
                            <div class="text-slate-400 small">ID: PAT-@appt.PatientId</div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-slate-700">Dr. @appt.Doctor?.FirstName</span>
                            </div>
                        </td>
                        <td>@appt.TimeSlot</td>
                        <td><span class="status-pill status-waiting">Waiting</span></td>
                        <td class="text-end">
                            <button onclick="serveToken(@appt.DoctorId, '@appt.TokenNumber')" class="serve-btn">
                                <i class="fa-solid fa-bell me-2"></i>Call Patient
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function serveToken(doctorId, tokenNumber) {
        $.post('/Admin/ServeToken', { doctorId: doctorId, tokenNumber: tokenNumber }, function(res) {
            if(res.success) {
                location.reload();
            }
        });
    }

    // Refresh page every 10 seconds to simulate real-time updates
    // In a real app we'd use SignalR
    setInterval(() => {
        // location.reload(); 
    }, 10000);
</script>