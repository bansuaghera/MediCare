@{
    ViewData["Title"] = "System Notifications";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<style>
    .notif-card {
        background: white;
        border-radius: 20px;
        padding: 20px;
        border: 1px solid #f1f5f9;
        margin-bottom: 15px;
        transition: 0.2s;
        display: flex;
        gap: 20px;
        align-items: center;
    }
    .notif-card:hover {
        border-color: #10b981;
        background: #fdfdfd;
    }
    .notif-unread {
        border-left: 5px solid #10b981;
    }
    .notif-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }
    .bg-green-soft { background: #ecfdf5; color: #10b981; }
    .bg-blue-soft { background: #eff6ff; color: #3b82f6; }
    .bg-orange-soft { background: #fffbeb; color: #f59e0b; }
</style>

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="fw-bold m-0"><i class="fa-regular fa-bell text-success me-2"></i> System Alert Hub</h1>
        <p class="text-muted">Stay informed about your clinical status and health updates</p>
    </div>
    <button class="btn btn-light rounded-pill px-4 border small fw-bold">Mark all as read</button>
</div>

<div class="max-width-900 mx-auto">
    <div class="notif-card notif-unread">
        <div class="notif-icon bg-green-soft">
            <i class="fa-solid fa-calendar-check"></i>
        </div>
        <div class="flex-grow-1">
            <div class="d-flex justify-content-between">
                <h6 class="fw-bold m-0">Appointment Confirmed</h6>
                <small class="text-muted">2 mins ago</small>
            </div>
            <p class="small text-muted m-0">Your session with Dr. Patel has been verified for tomorrow at 10:30 AM.</p>
        </div>
    </div>

    <div class="notif-card notif-unread">
        <div class="notif-icon bg-blue-soft">
            <i class="fa-solid fa-file-prescription"></i>
        </div>
        <div class="flex-grow-1">
            <div class="d-flex justify-content-between">
                <h6 class="fw-bold m-0">New Prescription Added</h6>
                <small class="text-muted">1 hour ago</small>
            </div>
            <p class="small text-muted m-0">A digital copy of your latest health record is now available in the archive.</p>
        </div>
    </div>

    <div class="notif-card">
        <div class="notif-icon bg-orange-soft">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div class="flex-grow-1">
            <div class="d-flex justify-content-between">
                <h6 class="fw-bold m-0">Schedule Update</h6>
                <small class="text-muted">Yesterday</small>
            </div>
            <p class="small text-muted m-0">Dr. Sharma's OPD slot for Saturday has been shifted to 11 AM.</p>
        </div>
    </div>

    <div class="text-center mt-5">
        <button class="btn btn-outline-secondary rounded-pill px-5 py-2 fw-bold small">Load Older Notifications</button>
    </div>
</div>
